function FH.resetPlayerESPRuntime()
	if FH.PlayerESPRuntime.PlayerAddedConnection then
		FH.PlayerESPRuntime.PlayerAddedConnection:Disconnect()
		FH.PlayerESPRuntime.PlayerAddedConnection = nil
	end
	if FH.PlayerESPRuntime.PlayerRemovingConnection then
		FH.PlayerESPRuntime.PlayerRemovingConnection:Disconnect()
		FH.PlayerESPRuntime.PlayerRemovingConnection = nil
	end
	if FH.PlayerESPRuntime.RenderConnection then
		FH.PlayerESPRuntime.RenderConnection:Disconnect()
		FH.PlayerESPRuntime.RenderConnection = nil
	end
	for player, connections in pairs(FH.PlayerESPRuntime.PlayerConnections) do
		for _, connection in pairs(connections) do
			pcall(function() connection:Disconnect() end)
		end
		FH.PlayerESPRuntime.PlayerConnections[player] = nil
	end
	for player, data in pairs(FH.PlayerESPRuntime.Objects) do
		if data.Board then pcall(function() data.Board:Destroy() end) end
		if data.Proxy then pcall(function() data.Proxy:Destroy() end) end
		FH.PlayerESPRuntime.Objects[player] = nil
	end
	for player, highlight in pairs(FH.PlayerESPRuntime.Highlights) do
		pcall(function() highlight:Destroy() end)
		PlayerHighlights[player] = nil
	end
end

FH._fpsOrig = {
	GlobalShadows = true,
	EnvDiffuse = 1,
	EnvSpecular = 1,
	Lights = {},
	Effects = {},
	Visuals = {},
	Terrain = nil,
	Lighting = {},
	QualityLevel = nil,
	Busy = false,
	Pending = nil
}

function FH.isProtectedFPSPart(part)
	if not part or not part:IsA("BasePart") then return true end
	local currentCamera = workspace.CurrentCamera
	if currentCamera and part:IsDescendantOf(currentCamera) then return true end
	if part:IsDescendantOf(PlayerGui) then return true end
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character and part:IsDescendantOf(player.Character) then
			return true
		end
	end
	local name = string.lower(part.Name)
	return name:find("esp", 1, true) ~= nil
		or name:find("marker", 1, true) ~= nil
		or name:find("highlight", 1, true) ~= nil
		or name:find("weapon", 1, true) ~= nil
end

function FH.applyFPSBoost(enabled)
	if FH._fpsOrig.Busy then
		FH._fpsOrig.Pending = enabled
		return
	end
	FH._fpsOrig.Busy = true
	FH._fpsOrig.Pending = nil
	FH.FPSBoost = enabled

	task.spawn(function()
		local Terrain = workspace:FindFirstChildOfClass("Terrain")
		if enabled then
			FH._fpsOrig.GlobalShadows = Lighting.GlobalShadows
			FH._fpsOrig.EnvDiffuse = Lighting.EnvironmentDiffuseScale
			FH._fpsOrig.EnvSpecular = Lighting.EnvironmentSpecularScale
			FH._fpsOrig.QualityLevel = nil
			pcall(function()
				FH._fpsOrig.QualityLevel = settings().Rendering.QualityLevel
			end)
			FH._fpsOrig.Lights = {}
			FH._fpsOrig.Effects = {}
			FH._fpsOrig.Visuals = {}
			FH._fpsOrig.Terrain = nil
			FH._fpsOrig.Lighting = {
				Brightness = Lighting.Brightness,
				Ambient = Lighting.Ambient,
				OutdoorAmbient = Lighting.OutdoorAmbient,
				ColorShift_Bottom = Lighting.ColorShift_Bottom,
				ColorShift_Top = Lighting.ColorShift_Top,
				ExposureCompensation = Lighting.ExposureCompensation,
				Technology = Lighting.Technology,
			}

			Lighting.GlobalShadows = false
			Lighting.EnvironmentDiffuseScale = 0
			Lighting.EnvironmentSpecularScale = 0
			pcall(function()
				Lighting.Brightness = 0
				Lighting.Ambient = Color3.new(0, 0, 0)
				Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
				Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)
				Lighting.ColorShift_Top = Color3.new(0, 0, 0)
				Lighting.ExposureCompensation = -2
				Lighting.Technology = Enum.Technology.Compatibility
			end)
			pcall(function()
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			end)

			for _, v in ipairs(Lighting:GetChildren()) do
				pcall(function()
					if v:IsA("PostEffect") or v:IsA("Atmosphere") then
						FH._fpsOrig.Effects[v] = v.Enabled
						v.Enabled = false
					end
				end)
			end

			local batch = 0
			local mapPartIndex = 0
			for _, v in ipairs(workspace:GetDescendants()) do
				pcall(function()
					if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
						or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
						FH._fpsOrig.Effects[v] = v.Enabled
						v.Enabled = false
					elseif v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
						FH._fpsOrig.Lights[v] = v.Enabled
						v.Enabled = false
					elseif v:IsA("BasePart") then
						FH._fpsOrig.Visuals[v] = {
							kind = "BasePart",
							Color = v.Color,
							CastShadow = v.CastShadow,
							Reflectance = v.Reflectance,
							Material = v.Material,
							MaterialVariant = v.MaterialVariant,
							TextureID = v:IsA("MeshPart") and v.TextureID or nil,
						}
						v.CastShadow = false
						v.Reflectance = 0
						v.Material = Enum.Material.SmoothPlastic
						pcall(function() v.MaterialVariant = "" end)
						if v:IsA("MeshPart") then
							pcall(function() v.TextureID = "" end)
						end
						if v.Anchored
							and v.Transparency < 1
							and v.Size.Magnitude > 2
							and not FH.isProtectedFPSPart(v)
						then
							mapPartIndex += 1
							if mapPartIndex % 3 == 0 then
								FH._fpsOrig.Visuals[v].Blackened = true
								v.Color = Color3.new(0, 0, 0)
							end
						end
					elseif v:IsA("Decal") or v:IsA("Texture") then
						if v.Transparency < 1 then
							FH._fpsOrig.Visuals[v] = {
								kind = "Texture",
								Transparency = v.Transparency
							}
							v.Transparency = 1
						end
					elseif v:IsA("SurfaceAppearance") then
						FH._fpsOrig.Visuals[v] = {
							kind = "SurfaceAppearance",
							ColorMap = v.ColorMap,
							MetalnessMap = v.MetalnessMap,
							NormalMap = v.NormalMap,
							RoughnessMap = v.RoughnessMap,
						}
						pcall(function()
							v.ColorMap = ""
							v.MetalnessMap = ""
							v.NormalMap = ""
							v.RoughnessMap = ""
						end)
					elseif v:IsA("SpecialMesh") then
						FH._fpsOrig.Visuals[v] = {
							kind = "SpecialMesh",
							TextureId = v.TextureId,
						}
						pcall(function() v.TextureId = "" end)
					end
				end)
				batch += 1
				if batch >= 350 then
					batch = 0
					task.wait()
				end
			end

			if Terrain then
				FH._fpsOrig.Terrain = {
					WaterWaveSize = Terrain.WaterWaveSize,
					WaterWaveSpeed = Terrain.WaterWaveSpeed,
					WaterReflectance = Terrain.WaterReflectance,
					WaterTransparency = Terrain.WaterTransparency
				}
				Terrain.WaterWaveSize = 0
				Terrain.WaterWaveSpeed = 0
				Terrain.WaterReflectance = 0
				Terrain.WaterTransparency = 1
			end
		else
			Lighting.GlobalShadows = FH._fpsOrig.GlobalShadows
			Lighting.EnvironmentDiffuseScale = FH._fpsOrig.EnvDiffuse
			Lighting.EnvironmentSpecularScale = FH._fpsOrig.EnvSpecular
			if FH._fpsOrig.Lighting then
				pcall(function()
					Lighting.Brightness = FH._fpsOrig.Lighting.Brightness
					Lighting.Ambient = FH._fpsOrig.Lighting.Ambient
					Lighting.OutdoorAmbient = FH._fpsOrig.Lighting.OutdoorAmbient
					Lighting.ColorShift_Bottom = FH._fpsOrig.Lighting.ColorShift_Bottom
					Lighting.ColorShift_Top = FH._fpsOrig.Lighting.ColorShift_Top
					Lighting.ExposureCompensation = FH._fpsOrig.Lighting.ExposureCompensation
					Lighting.Technology = FH._fpsOrig.Lighting.Technology
				end)
			end
			for obj, was in pairs(FH._fpsOrig.Effects) do
				if obj and obj.Parent then
					pcall(function() obj.Enabled = was end)
				end
			end
			for light, was in pairs(FH._fpsOrig.Lights) do
				if light and light.Parent then
					pcall(function() light.Enabled = was end)
				end
			end
			for obj, original in pairs(FH._fpsOrig.Visuals) do
				if obj and obj.Parent then
					pcall(function()
						if original.kind == "BasePart" then
							obj.Color = original.Color
							obj.CastShadow = original.CastShadow
							obj.Reflectance = original.Reflectance
							obj.Material = original.Material
							pcall(function() obj.MaterialVariant = original.MaterialVariant or "" end)
							if obj:IsA("MeshPart") and original.TextureID ~= nil then
								pcall(function() obj.TextureID = original.TextureID end)
							end
						elseif original.kind == "Texture" then
							obj.Transparency = original.Transparency
						elseif original.kind == "SurfaceAppearance" then
							obj.ColorMap = original.ColorMap
							obj.MetalnessMap = original.MetalnessMap
							obj.NormalMap = original.NormalMap
							obj.RoughnessMap = original.RoughnessMap
						elseif original.kind == "SpecialMesh" then
							obj.TextureId = original.TextureId
						end
					end)
				end
			end
			if FH._fpsOrig.QualityLevel then
				pcall(function()
					settings().Rendering.QualityLevel = FH._fpsOrig.QualityLevel
				end)
			end
			if Terrain and FH._fpsOrig.Terrain then
				pcall(function()
					Terrain.WaterWaveSize = FH._fpsOrig.Terrain.WaterWaveSize
					Terrain.WaterWaveSpeed = FH._fpsOrig.Terrain.WaterWaveSpeed
					Terrain.WaterReflectance = FH._fpsOrig.Terrain.WaterReflectance
					Terrain.WaterTransparency = FH._fpsOrig.Terrain.WaterTransparency
				end)
			end
		end
		FH._fpsOrig.Busy = false
		if FH._fpsOrig.Pending ~= nil and FH._fpsOrig.Pending ~= enabled then
			local pending = FH._fpsOrig.Pending
			FH._fpsOrig.Pending = nil
			FH.applyFPSBoost(pending)
		end
	end)
end

