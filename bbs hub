function FH.applyConfigState(data)
	if type(data) ~= "table" then return false end
	FH.SilentAimEnabled = data.SilentAimEnabled == true
	FH.SilentAimFOV = math.clamp(tonumber(data.SilentAimFOV) or FH.SilentAimFOV, 20, FH.isPCMode and 1000 or 800)
	FH.SilentAimIgnoreSafeZone = data.SilentAimIgnoreSafeZone ~= false
	FH.ShowSilentAimFOV = data.ShowFOV ~= false
	FH.NoRecoil = data.NoRecoil == true
	FH.HideName = data.HideName == true
	FH.PickupEnabled = data.PickupEnabled == true
	if type(data.PickupRarities) == "table" then
		FH.applyPickupRaritySelection(data.PickupRarities)
	end
	
	if data.DroppedItemsESPEnabled ~= nil then
		FH.DroppedItemsESPEnabled = data.DroppedItemsESPEnabled == true
		if not FH.DroppedItemsESPEnabled then
			FH.clearDroppedItemsESP()
		end
	end

	if data.EquippedItemsESPEnabled ~= nil then
		FH.EquippedItemsESPConfigured = data.EquippedItemsESPEnabled == true
	else
		FH.EquippedItemsESPConfigured = FH.ESPEnabled
	end

	local savedPlayerESP = type(data.PlayerESP) == "table" and data.PlayerESP or nil
	if data.PlayerHighlightEnabled ~= nil then
		FH.ESPConfig.Highlight = data.PlayerHighlightEnabled == true
	elseif savedPlayerESP and savedPlayerESP.Highlight ~= nil then
		FH.ESPConfig.Highlight = savedPlayerESP.Highlight == true
	end
	FH.PlayerHighlightEnabled = FH.ESPConfig.Highlight
	
	if data.PlayerNameESPEnabled ~= nil then
		FH.ESPConfig.NameESP = data.PlayerNameESPEnabled == true
	elseif savedPlayerESP and savedPlayerESP.NameESP ~= nil then
		FH.ESPConfig.NameESP = savedPlayerESP.NameESP == true
	end
	FH.PlayerNameESPEnabled = FH.ESPConfig.NameESP

	if data.PlayerNameESPDistance ~= nil then
		FH.ESPConfig.NameESPDistance = data.PlayerNameESPDistance == true
	elseif savedPlayerESP and savedPlayerESP.NameESPDistance ~= nil then
		FH.ESPConfig.NameESPDistance = savedPlayerESP.NameESPDistance == true
	end
	FH.PlayerNameESPDistance = FH.ESPConfig.NameESPDistance

	if data.PlayerHealthESPEnabled ~= nil then
		FH.ESPConfig.HealthESP = data.PlayerHealthESPEnabled == true
	elseif savedPlayerESP and savedPlayerESP.HealthESP ~= nil then
		FH.ESPConfig.HealthESP = savedPlayerESP.HealthESP == true
	end
	FH.PlayerHealthESPEnabled = FH.ESPConfig.HealthESP

	FH.PlayerHighlightRefreshRequested = true
	FH.PlayerMarkerRefreshRequested = true
	FH.FPSBoost = data.FPSBoost == true
	FH.EnabledSkip = data.EnabledSkip == true
	FH.AutomaticGun = data.AutomaticGun == true
	FH.FireRateValue = math.clamp(tonumber(data.FireRateValue) or FH.FireRateValue, 1, 2500)
	FH.AccuracyValue = math.clamp(tonumber(data.AccuracyValue) or FH.AccuracyValue, 0, 1)
	FH.CarModsEnabled = data.CarModsEnabled == true
	FH.CarPlayerSpeed = math.clamp(tonumber(data.CarPlayerSpeed) or FH.CarPlayerSpeed, 10, 250)
	FH.FlyCarEnabled = data.FlyCarEnabled == true
	FH.FlyCarHeight = math.clamp(
		tonumber(data.FlyCarHeight) or FH.FlyCarHeight,
		FH.FLY_CAR_MIN_HEIGHT,
		FH.FLY_CAR_MAX_HEIGHT
	)
	FH.CarArmorEnabled = data.CarArmorEnabled == true
	FH.BumpAuraEnabled = data.BumpAuraEnabled == true
	FH.SpeedHackEnabled = data.SpeedHackEnabled == true
	FH.JumpPowerEnabled = data.JumpPowerEnabled == true
	FH.MeleeAuraEnabled = data.MeleeAuraEnabled == true
	FH.SilentMixEnabled = data.SilentMixEnabled == true
	FH.SpectateEnabled = data.SpectateEnabled == true
	FH.TactilPanelEnabled = data.TactilPanelEnabled == true
	FH.SilentAimNextPartIsHead = true
	FH.activateImmediateConfiguredRuntime()
	FH.StartupDeferredConfigToken += 1
	local token = FH.StartupDeferredConfigToken
	task.delay(FH.STARTUP_DEFERRED_SECONDS, function()
		if token == FH.StartupDeferredConfigToken then
			FH.activateDeferredConfiguredRuntime()
		end
	end)
	return true
end

function FH.loadStartupConfig()
	if not FH.ConfigFSAvailable then return false end

	local _, lastConfig = FH.readConfigIndex()
	FH.ConfigManager.LastConfig = lastConfig or "Default"

	-- Si el indice se perdio o nunca se escribio, igual se intenta con
	-- "Default", para que una configuracion guardada nunca quede huerfana.
	local candidates = {FH.ConfigManager.LastConfig}
	if FH.ConfigManager.LastConfig ~= "Default" then
		candidates[#candidates + 1] = "Default"
	end

	for _, name in ipairs(candidates) do
		local data = FH.readConfigFile(name)
		if data then
			FH.ConfigManager.LastConfig = name
			local applied = false
			pcall(function()
				applied = FH.applyConfigState(data) == true
			end)
			if applied then return true end
		end
	end
	return false
end

FH.ConfigAutoSaveToken = 0
FH.ConfigReady = false

-- Cada toggle guarda solo, un segundo despues del ultimo cambio, para que no
-- haya que acordarse de apretar "Save Configuration".
function FH.requestConfigAutoSave()
	if not FH.ConfigReady then return end
	FH.ConfigAutoSaveToken += 1
	local token = FH.ConfigAutoSaveToken
	task.delay(1, function()
		if token ~= FH.ConfigAutoSaveToken then return end
		pcall(function()
			FH.ConfigManager:Save(FH.ConfigManager.LastConfig or "Default")
		end)
	end)
end

function FH.ConfigManager:List()
	local names, lastConfig = FH.readConfigIndex()
	if #names > self.MaxConfigs then
		local trimmed = {}
		for index = 1, self.MaxConfigs do
			trimmed[index] = names[index]
		end
		names = trimmed
		FH.writeConfigIndex(names, lastConfig)
	end
	return names, lastConfig
end

function FH.ConfigManager:Save(name)
	if not FH.ConfigFSAvailable then
		return false, "ARCHIVOS NO DISPONIBLES"
	end
	local safeName = FH.cleanConfigName(name or self.LastConfig)
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(FH.captureConfigState())
	end)
	if not ok then return false, "ERROR PREPARING CONFIGURATION" end
	local names = self:List()
	local exists = false
	for _, configName in ipairs(names) do
		if configName == safeName then exists = true break end
	end
	if not exists and #names >= self.MaxConfigs then
		return false, "LÍMITE ALCANZADO: MÁXIMO 3 CONFIGURACIONES"
	end
	if not FH.writeConfigFile(safeName, encoded) then
		return false, "ERROR AL GUARDAR CONFIGURACIÓN"
	end
	if not exists then names[#names + 1] = safeName end
	self.LastConfig = safeName
	FH.writeConfigIndex(names, self.LastConfig)
	return true, safeName
end

function FH.ConfigManager:Load(name)
	if not FH.ConfigFSAvailable then return false, "ARCHIVOS NO DISPONIBLES" end
	local safeName = FH.cleanConfigName(name or self.LastConfig)
	local data = FH.readConfigFile(safeName)
	if not data then return false, "CONFIGURACIÓN NO ENCONTRADA" end
	if not FH.applyConfigState(data) then
		return false, "ERROR AL CARGAR CONFIGURACIÓN"
	end
	local names = self:List()
	self.LastConfig = safeName
	FH.writeConfigIndex(names, self.LastConfig)
	return true, safeName
end

function FH.ConfigManager:Delete(name)
	if not FH.ConfigFSAvailable or not FH.ensureConfigFolder() then
		return false, "ARCHIVOS NO DISPONIBLES"
	end
	local safeName = FH.cleanConfigName(name or self.LastConfig or "Default")
	local configPath = FH.getConfigPath(safeName)
	if not isfile(configPath) then
		return false, "CONFIGURACIÓN NO ENCONTRADA"
	end
	local deleted = pcall(function()
		delfile(configPath)
	end)
	if not deleted then
		return false, "ERROR AL ELIMINAR CONFIGURACIÓN"
	end
	local names, lastConfig = FH.readConfigIndex()
	local remaining = {}
	for _, configName in ipairs(names) do
		if configName ~= safeName then
			remaining[#remaining + 1] = configName
		end
	end
	if #remaining == 0 then remaining = {"Default"} end
	if lastConfig == safeName then
		lastConfig = remaining[1]
	end
	self.LastConfig = lastConfig
	FH.writeConfigIndex(remaining, lastConfig)
	return true, safeName
end

