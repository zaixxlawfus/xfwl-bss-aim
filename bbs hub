FH.safeZoneParts, FH.lastSafeZoneUpdate = {}, 0
FH.SAFE_KEYWORDS = {"safe", "spawn", "lobby", "hub", "refuge", "zone"}
function FH.hasSafeKeyword(name)
	local n = name:lower()
	for _, k in ipairs(FH.SAFE_KEYWORDS) do
		if n:find(k, 1, true) then return true end
	end
	return false
end
function FH.refreshSafeZoneParts()
	FH.safeZoneParts = {}
	for _, obj in pairs(workspace:GetChildren()) do
		if obj:IsA("BasePart") and FH.hasSafeKeyword(obj.Name) then
			FH.safeZoneParts[#FH.safeZoneParts + 1] = obj
		elseif obj:IsA("Model") or obj:IsA("Folder") then
			if FH.hasSafeKeyword(obj.Name) then
				for _, p in pairs(obj:GetDescendants()) do
					if p:IsA("BasePart") then
						FH.safeZoneParts[#FH.safeZoneParts + 1] = p
					end
				end
			end
		end
	end
end
FH.isInSafeZone = function(root)
	local now = tick()
	if now - FH.lastSafeZoneUpdate > 6 then
		FH.refreshSafeZoneParts()
		FH.lastSafeZoneUpdate = now
	end
	if #FH.safeZoneParts == 0 then return false end
	local rp = root.Position
	for _, part in ipairs(FH.safeZoneParts) do
		if part and part.Parent then
			local sz = part.Size / 2
			local lp = part.CFrame:PointToObjectSpace(rp)
			if math.abs(lp.X) <= sz.X and math.abs(lp.Y) <= sz.Y and math.abs(lp.Z) <= sz.Z then
				return true
			end
		end
	end
	return false
end

