TP.SettingsVisual.RefreshTouchDepthText = function()
	if TP.fsInput and TP.fsInput.Parent then
		TP.fsInput.Text = tostring(TP.TouchPanelValue) .. "m"
		TP.targetDepth = TP.TouchPanelValue
	end
end

TP.fsInput.FocusLost:Connect(function()
	local num = tonumber(TP.fsInput.Text:match("%d+"))
	if num then
		local snapActive =
			TP.SettingsVisual.TouchSnapCarState
			and TP.SettingsVisual.TouchSnapCarState.Enabled

		TP.TouchPanelValue = math.clamp(num, 5, snapActive and 2000 or 100)
		TP.targetDepth = TP.TouchPanelValue
		TP.fsInput.Text = tostring(TP.TouchPanelValue) .. "m"

		-- EDICIÓN MANUAL: congela este valor y detiene el escaneo automático
		-- hasta que el personaje se reinicie / reaparezca.
		TP.SettingsVisual.TouchItemDistanceManualLocked = not snapActive
		TP.SettingsVisual.TouchItemDistanceManualValue = TP.TouchPanelValue
		TP.SettingsVisual.TouchItemDistanceTarget = nil
		TP.SettingsVisual.TouchItemDistanceSavedValue = nil

		-- NUEVO: si Snap Car YA está abajo, el número se vuelve
		-- profundidad real del carro inmediatamente (30m, 40m, etc.).
		if TP.SettingsVisual.TouchSnapCarState
			and TP.SettingsVisual.TouchSnapCarState.Enabled
			and TP.SettingsVisual.TouchSnapCarApplyManualDepth then
			TP.SettingsVisual.TouchSnapCarApplyManualDepth(TP.TouchPanelValue)
		end
	else
		TP.fsInput.Text = tostring(TP.TouchPanelValue) .. "m"
	end
end)

-- Al reaparecer el personaje se libera cualquier valor manual y el tracker
-- vuelve a hacer el escaneo normal desde cero. El número manual actual queda
-- como valor base hasta que encuentre un nuevo ítem válido.
TP.SettingsVisual.TouchItemDistanceRespawnConnection =
	Player.CharacterAdded:Connect(function()
		TP.SettingsVisual.TouchItemDistanceManualLocked = false
		TP.SettingsVisual.TouchItemDistanceManualValue = nil
		TP.SettingsVisual.TouchItemDistanceTarget = nil
		TP.SettingsVisual.TouchItemDistanceSavedValue = nil

		task.defer(function()
			task.wait(0.15)
			if TP.fsInput and TP.fsInput.Parent then
				TP.fsInput.Text = tostring(TP.TouchPanelValue) .. "m"
			end
		end)
	end)

