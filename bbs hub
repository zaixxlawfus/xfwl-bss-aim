	local function updatePlayerNameESP(player)
		if player == LocalPlayer then return end
		if not FH.ESPConfig.NameESP then
			clearPlayerNameESP(player)
			return
		end

		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local localChar = LocalPlayer.Character
		local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
		local targetRoot = character and character:FindFirstChild("HumanoidRootPart")

		if not character or not head or not targetRoot then
			local existingGui = PlayerNameESPGuis[player]
			if existingGui then existingGui.Enabled = false end
			return
		end

		local distance = 0
		if localRoot then
			distance = (localRoot.Position - targetRoot.Position).Magnitude
		end
		local dynamicHeightOffset = 3.2 + math.clamp(distance * 0.04, 0, 8.5)

		local existingGui = PlayerNameESPGuis[player]
		if not existingGui or not existingGui.Parent then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "PlayerNameESP"
			billboard.Adornee = head
			billboard.Size = UDim2.fromOffset(200, 52)
			billboard.StudsOffsetWorldSpace = Vector3.new(0, dynamicHeightOffset, 0)
			billboard.AlwaysOnTop = true
			billboard.LightInfluence = 0
			billboard.Enabled = true
			billboard.Parent = PlayerGui

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Name = "NameText"
			nameLabel.Position = UDim2.new(0, 0, 0, 0)
			nameLabel.Size = UDim2.new(1, 0, 0, 16)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Font = Enum.Font.Gotham
			nameLabel.TextSize = 11
			nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			nameLabel.TextStrokeTransparency = 0.6
			nameLabel.TextXAlignment = Enum.TextXAlignment.Center
			nameLabel.TextYAlignment = Enum.TextYAlignment.Center
			nameLabel.Parent = billboard

			local distLabel = Instance.new("TextLabel")
			distLabel.Name = "DistText"
			distLabel.Position = UDim2.new(0, 0, 0, 16)
			distLabel.Size = UDim2.new(1, 0, 0, 12)
			distLabel.BackgroundTransparency = 1
			distLabel.Font = Enum.Font.Gotham
			distLabel.TextSize = 9
			distLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
			distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			distLabel.TextStrokeTransparency = 0.6
			distLabel.TextXAlignment = Enum.TextXAlignment.Center
			distLabel.TextYAlignment = Enum.TextYAlignment.Center
			distLabel.Parent = billboard

			local healthFrame = Instance.new("Frame")
			healthFrame.Name = "HealthFrame"
			healthFrame.AnchorPoint = Vector2.new(0.5, 0)
			healthFrame.Position = UDim2.new(0.5, 0, 0, 30)
			healthFrame.Size = UDim2.fromOffset(60, 4)
			healthFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
			healthFrame.BackgroundTransparency = 0.3
			healthFrame.BorderSizePixel = 0
			healthFrame.Parent = billboard
			Instance.new("UICorner", healthFrame).CornerRadius = UDim.new(1, 0)

			local healthFill = Instance.new("Frame")
			healthFill.Name = "HealthFill"
			healthFill.Size = UDim2.new(1, 0, 1, 0)
			healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			healthFill.BorderSizePixel = 0
			healthFill.Parent = healthFrame
			Instance.new("UICorner", healthFill).CornerRadius = UDim.new(1, 0)

			PlayerNameESPGuis[player] = billboard
			existingGui = billboard
		else
			existingGui.Adornee = head
			existingGui.StudsOffsetWorldSpace = Vector3.new(0, dynamicHeightOffset, 0)
			existingGui.Enabled = true
		end

		local nameLabel = existingGui:FindFirstChild("NameText")
		local distLabel = existingGui:FindFirstChild("DistText")
		local healthFrame = existingGui:FindFirstChild("HealthFrame")
		local healthFill = healthFrame and healthFrame:FindFirstChild("HealthFill")

		if nameLabel then
			nameLabel.Text = player.Name
			local isTargetedByAim = FH.SilentAimEnabled and FH.SilentAimCurrentTarget == player
			if isTargetedByAim then
				nameLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
			else
				local root = markerAnchor(character)
				if root and FH.isInSafeZone and FH.isInSafeZone(root) then
					nameLabel.TextColor3 = HIGHLIGHT_SAFE_COLOR
				else
					nameLabel.TextColor3 = HIGHLIGHT_NORMAL_COLOR
				end
			end
		end

		if distLabel then
			distLabel.Visible = FH.ESPConfig.NameESPDistance
			if FH.ESPConfig.NameESPDistance then
				distLabel.Text = tostring(math.floor(distance + 0.5)) .. " m"
			end
		end

		if healthFrame and healthFill then
			healthFrame.Visible = FH.ESPConfig.HealthESP
			if FH.ESPConfig.HealthESP and humanoid then
				local healthPercent = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
				healthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
				if healthPercent > 0.5 then
					healthFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(0, 255, 0), (healthPercent - 0.5) * 2)
				else
					healthFill.BackgroundColor3 = Color3.fromRGB(255, 255, 0):Lerp(Color3.fromRGB(255, 0, 0), (0.5 - healthPercent) * 2)
				end
			end
		end
	end

	-- Se expone para que el boton "Update Esp" del panel tactil lo pueda usar.
	local function setPlayerNameESP(enabled)
		FH.ESPConfig.NameESP = enabled == true
		FH.PlayerNameESPEnabled = FH.ESPConfig.NameESP
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				if FH.ESPConfig.NameESP then
					updatePlayerNameESP(player)
				else
					clearPlayerNameESP(player)
				end
			end
		end
	end
	FH.setPlayerNameESP = setPlayerNameESP

	local function updatePlayerHighlight(player)
		if player == LocalPlayer then return end
		if not FH.ESPConfig.Highlight then
			clearPlayerHighlight(player)
			return
		end

		local character = player.Character
		local existingHighlight = PlayerHighlights[player]

		if existingHighlight and existingHighlight.Parent then
			if character then
				pcall(function()
					if existingHighlight.Adornee ~= character then
						existingHighlight.Adornee = character
					end
					local highlightColor = getPlayerHighlightColor(player, character)
					if FH.SilentAimEnabled and FH.getSilentAimTarget() == player then
						highlightColor = HIGHLIGHT_HIT_COLOR
					end
					if existingHighlight.FillColor ~= highlightColor then
						existingHighlight.FillColor = highlightColor
					end
					if existingHighlight.OutlineColor ~= highlightColor then
						existingHighlight.OutlineColor = highlightColor
					end
					existingHighlight.Enabled = isPlayerESPInRange(character)
				end)
			else
				pcall(function()
					existingHighlight.Enabled = false
				end)
			end
			return
		end

		if existingHighlight then
			PlayerHighlights[player] = nil
		end

		if not character or not markerAnchor(character) then
			return
		end

		local highlight = Instance.new("Highlight")
		highlight.Name = "PlayerHighlight"
		highlight.Adornee = character
		local highlightColor = getPlayerHighlightColor(player, character)
		if FH.SilentAimEnabled and FH.getSilentAimTarget() == player then
			highlightColor = HIGHLIGHT_HIT_COLOR
		end
		highlight.FillColor = highlightColor
		highlight.OutlineColor = highlightColor
		highlight.FillTransparency = HIGHLIGHT_FILL_TRANSPARENCY
		highlight.OutlineTransparency = HIGHLIGHT_OUTLINE_TRANSPARENCY
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Enabled = isPlayerESPInRange(character)
		highlight.Parent = workspace
		PlayerHighlights[player] = highlight
	end

	local function refreshPlayerHighlights()
		if not FH.ESPConfig.Highlight then return end
		local now = os.clock()
		for player, highlight in pairs(PlayerHighlights) do
			if not player.Parent or not highlight.Parent then
				clearPlayerHighlight(player)
			elseif (PlayerHitEffectUntil[player] or 0) <= now then
				local character = player.Character
				if not character or highlight.Adornee ~= character then
					updatePlayerHighlight(player)
				else
					local highlightColor = getPlayerHighlightColor(player, character)
					if FH.SilentAimEnabled and FH.getSilentAimTarget() == player then
						highlightColor = HIGHLIGHT_HIT_COLOR
					end
					if highlight.FillColor ~= highlightColor then
						highlight.FillColor = highlightColor
					end
					if highlight.OutlineColor ~= highlightColor then
						highlight.OutlineColor = highlightColor
					end
				end
			end
		end
	end

	local function setPlayerHighlight(enabled)
		FH.ESPConfig.Highlight = enabled == true
		FH.PlayerHighlightEnabled = FH.ESPConfig.Highlight
		if applyPlayerESPToAll then
			applyPlayerESPToAll()
			return
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				updatePlayerHighlight(player)
			end
		end
	end

	local function mountPlayerMarker(player)
		if player == LocalPlayer or PlayerMarkers[player] then return end
		local character = player.Character
		if not character then return end

		local markerSeed = {Proxy = nil}
		local anchor = getPlayerMarkerAnchor(markerSeed, character)
		if not anchor then return end

		local board = Instance.new("BillboardGui")
		board.Name = "PlayerMarker"
		board.Adornee = anchor
		board.Size = UDim2.fromOffset(132, 68)
		board.StudsOffsetWorldSpace = Vector3.new(0, 2.75, 0)
		board.AlwaysOnTop = true
		board.LightInfluence = 0
		board.MaxDistance = 0
		board.Enabled = false
		board.Parent = PlayerGui

		local panel = Instance.new("Frame")
		panel.Size = UDim2.new(1, 0, 1, 0)
		panel.BackgroundTransparency = 1
		panel.BorderSizePixel = 0
		panel.ClipsDescendants = false
		panel.Parent = board
		local panelStroke = Instance.new("UIStroke", panel)
		panelStroke.Transparency = 1

		PlayerMarkers[player] = {
			Board = board,
			Panel = panel,
			Character = character,
			PanelStroke = panelStroke,
			Proxy = markerSeed.Proxy,
		}
	end

	local function unmountPlayerMarker(player)
		local marker = PlayerMarkers[player]
		if not marker then return end
		if marker.Board then marker.Board:Destroy() end
		if marker.Proxy then marker.Proxy:Destroy() end
		PlayerMarkers[player] = nil
	end

	local function hidePlayerMarker(marker)
		if marker.Board then marker.Board.Enabled = false end
	end

	local function refreshPlayerMarkers()
		for player, highlight in pairs(PlayerHighlights) do
			if player ~= LocalPlayer
				and player.Parent == Players
				and highlight
				and highlight.Parent
			then
				pcall(function()
					ensurePlayerMarker(player)
				end)
			end
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local character = player.Character
				pcall(function()
					local marker = PlayerMarkers[player]
					local markerDestroyed = marker and (
						not marker.Board
						or not marker.Board.Parent
					)
					if markerDestroyed then
						unmountPlayerMarker(player)
						marker = nil
					elseif marker and character and marker.Character ~= character then
						marker.Character = character
					end
					if character then
						ensurePlayerMarker(player)
					end
				end)
			end
		end
		for player, marker in pairs(PlayerMarkers) do
			pcall(function()
				local character = player.Character
				local anchor = getPlayerMarkerAnchor(marker, character)

				if player.Parent ~= Players or not character or not anchor then
					hidePlayerMarker(marker)
					return
				end

				marker.Board.Adornee = anchor
				marker.Board.MaxDistance = 0
				marker.Board.AlwaysOnTop = true
				marker.Board.Enabled = false
			end)
		end
	end

	local function setupPlayer(player)
		if player == LocalPlayer or player.Parent ~= Players then return end
		if FH.PlayerESPRuntime.PlayerConnections[player] then return end
		local connections = {}
		local function tryCreateForCharacter(character)
			if player.Parent ~= Players or player.Character ~= character then return end
			mountPlayerMarker(player)
		end
		local function bindHealthWatcher(character, humanoid)
			if not humanoid
				or player.Parent ~= Players
				or player.Character ~= character
			then
				return
			end
			if connections.HighlightHealth then
				connections.HighlightHealth:Disconnect()
				connections.HighlightHealth = nil
			end
			local previousHealth = humanoid.Health
			connections.HighlightHealth = humanoid.HealthChanged:Connect(function(health)
				previousHealth = health
			end)
		end
		local function watchCharacter(character)
			if not character then return end
			local currentMarker = PlayerMarkers[player]
			if currentMarker and currentMarker.Character ~= character then
				currentMarker.Character = character
			end
			mountPlayerMarker(player)
			updatePlayerHighlight(player)
			updatePlayerNameESP(player)
			if connections.CharacterDescendant then
				connections.CharacterDescendant:Disconnect()
				connections.CharacterDescendant = nil
			end
			if connections.CharacterDescendantRemoving then
				connections.CharacterDescendantRemoving:Disconnect()
				connections.CharacterDescendantRemoving = nil
			end
			if connections.HumanoidDied then
				connections.HumanoidDied:Disconnect()
				connections.HumanoidDied = nil
			end
			if connections.HighlightHealth then
				connections.HighlightHealth:Disconnect()
				connections.HighlightHealth = nil
			end
			connections.CharacterDescendant = character.DescendantAdded:Connect(function(descendant)
				if descendant:IsA("Humanoid") then
					bindHealthWatcher(character, descendant)
				end
				if descendant:IsA("BasePart") or descendant:IsA("Humanoid") then
					task.defer(function()
						tryCreateForCharacter(character)
					end)
				end
			end)
			if connections.CharacterDescendantRemoving then
				connections.CharacterDescendantRemoving:Disconnect()
				connections.CharacterDescendantRemoving = nil
			end
			bindHealthWatcher(
				character,
				findCharacterHumanoid(character)
			)
			task.defer(function()
				tryCreateForCharacter(character)
			end)
			task.delay(0.1, function()
				tryCreateForCharacter(character)
			end)
		end
		connections.CharacterAdded = player.CharacterAdded:Connect(watchCharacter)
		connections.CharacterAppearanceLoaded = player.CharacterAppearanceLoaded:Connect(function(character)
			if player.Character == character then
				task.defer(function()
					if player.Parent == Players and not PlayerMarkers[player] then
						pcall(function() mountPlayerMarker(player) end)
					end
				end)
			end
		end)
		connections.CharacterRemoving = player.CharacterRemoving:Connect(function()
			local marker = PlayerMarkers[player]
			if marker and marker.Board then
				pcall(function() marker.Board.Enabled = false end)
			end
			local highlight = PlayerHighlights[player]
			if highlight and highlight.Parent then
				pcall(function() highlight.Enabled = false end)
			end
			clearPlayerNameESP(player)
		end)
		local character = player.Character
		if character then
			watchCharacter(character)
		end
		FH.PlayerESPRuntime.PlayerConnections[player] = connections
	end

	local function queuePlayerMarker(player)
		if player == LocalPlayer or player.Parent ~= Players then return end
		local token = (PlayerMarkerRetryTokens[player] or 0) + 1
		PlayerMarkerRetryTokens[player] = token
		task.spawn(function()
			for _ = 1, 50 do
				if PlayerMarkerRetryTokens[player] ~= token
					or player.Parent ~= Players
					or PlayerMarkers[player]
				then
					return
				end
				if player.Character then
					pcall(function()
						mountPlayerMarker(player)
					end)
				end
				if PlayerMarkers[player] then return end
				task.wait(0.1)
			end
		end)
	end

	ensurePlayerMarker = function(player)
		if player == LocalPlayer or player.Parent ~= Players then return end

		local character = player.Character
		local marker = PlayerMarkers[player]
		local markerDestroyed = marker and (
			not marker.Board
			or not marker.Board.Parent
		)
		if markerDestroyed then
			unmountPlayerMarker(player)
			marker = nil
		elseif marker and character and marker.Character ~= character then
			marker.Character = character
		end

		if character and not marker then
			pcall(function()
				mountPlayerMarker(player)
			end)
		end

		if character and not PlayerMarkers[player] then
			queuePlayerMarker(player)
		end
	end

	local function syncAllPlayers()
		local serverPlayers = Players:GetPlayers()
		local serverRoster = {}
		FH.PlayerESPRuntime.ServerPlayerCount = #serverPlayers

		for _, player in ipairs(serverPlayers) do
			serverRoster[player] = true
			if player ~= LocalPlayer then
				pcall(function()
					setupPlayer(player)
					ensurePlayerMarker(player)
					updatePlayerHighlight(player)
					updatePlayerNameESP(player)
				end)
			end
		end
		for player in pairs(PlayerMarkers) do
			if not serverRoster[player] or player.Parent ~= Players then
				unmountPlayerMarker(player)
			end
		end
		for player in pairs(PlayerNameESPGuis) do
			if not serverRoster[player] or player.Parent ~= Players then
				clearPlayerNameESP(player)
			end
		end
	end

	applyPlayerESPToAll = function()
		syncAllPlayers()
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				pcall(function()
					updatePlayerHighlight(player)
					updatePlayerNameESP(player)
					ensurePlayerMarker(player)
				end)
			end
		end
		pcall(refreshPlayerHighlights)
	end

	task.defer(applyPlayerESPToAll)

	FH.PlayerESPRuntime.PlayerAddedConnection = Players.PlayerAdded:Connect(function(pl)
		pcall(function()
			setupPlayer(pl)
		end)
		task.defer(applyPlayerESPToAll)
	end)

	FH.PlayerESPRuntime.PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(pl)
		if FH.SpectateState.Player == pl then
			FH.stopSpectating()
		end
		if FH.SpectateTarget == pl then
			FH.SpectateTarget = nil
		end
		PlayerMarkerRetryTokens[pl] = nil
		unmountPlayerMarker(pl)
		clearPlayerHighlight(pl)
		clearPlayerNameESP(pl)
		local connections = FH.PlayerESPRuntime.PlayerConnections[pl]
		if connections then
			for _, connection in pairs(connections) do
				pcall(function() connection:Disconnect() end)
			end
			FH.PlayerESPRuntime.PlayerConnections[pl] = nil
		end
	end)

	local playerSyncElapsed = 0
	local recoilScanElapsed = 0
	local gunModScanElapsed = 0

	FH.PlayerESPRuntime.RenderConnection = RunService.RenderStepped:Connect(function(deltaTime)
		playerSyncElapsed = playerSyncElapsed + deltaTime
		if FH.NoRecoil then
			recoilScanElapsed = recoilScanElapsed + deltaTime
			local character = LocalPlayer.Character
			local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
			if recoilScanElapsed >= 0.75
				or FH.NoRecoilRuntime.LastCharacter ~= character
				or FH.NoRecoilRuntime.LastBackpack ~= backpack
			then
