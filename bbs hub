		local root = char and char:FindFirstChild("HumanoidRootPart")

		if not targetRoot or not targetHum or targetHum.Health <= 0 or not root or not hum or hum.Health <= 0 then
			TP.SettingsVisual.SetTouchTargetFollow(false)
			return
		end

		local distance = tonumber(TP.SettingsVisual.TouchTargetFollowDistance) or 5
