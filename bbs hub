	FH.requestConfigAutoSave()
end

function FH.CheckAndPickup()
	if not FH.PickupEnabled then return end
	local character = LocalPlayer.Character
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local DroppedItems = Workspace:FindFirstChild("DroppedItems")
	if not DroppedItems then return end
	local pickupRangeSquared = FH.Pickup_Range * FH.Pickup_Range
	local rootPosition = root.Position
	for _, item in ipairs(DroppedItems:GetChildren()) do
		if item:IsA("Model") then
			local part = item:FindFirstChildWhichIsA("BasePart")
			if part then
				local offset = rootPosition - part.Position
				if offset:Dot(offset) <= pickupRangeSquared
					and not FH.CollectedItems[item]
					and FH.isPickupRarityAllowed(item)
				then
					FH.CollectedItems[item] = true
					task.spawn(function()
						FH.NetGet("pickup_dropped_item", item)
					end)
				end
			end
		end
	end
end

task.spawn(function()
	-- Mas rapido que antes (0.2 s -> 0.05 s). La lista de lo ya pedido se
	-- limpia cada segundo en vez de en cada vuelta, para no reenviar el
