		local function isPointerInput(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
		end

		-- Un solo joystick para todo: arriba acelera, abajo va en reversa y
		-- los lados giran. La perilla se mueve dentro de un circulo.
		local function updateSteeringJoystick(input)
			local travel = math.max(0, (joystick.AbsoluteSize.X - knob.AbsoluteSize.X) / 2)
			if travel <= 0 then return end

			local center = joystick.AbsolutePosition + joystick.AbsoluteSize / 2
			local offset = Vector2.new(input.Position.X, input.Position.Y) - center
			if offset.Magnitude > travel then
				offset = offset.Unit * travel
			end
			knob.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y)

			local normalized = offset / travel
			-- En diagonal el circulo daria 0.7 en cada eje, o sea manejar mas
			-- lento al girar. Se estira al cuadrado para que en el borde de la
			-- diagonal salga aceleracion y giro completos.
			local largest = math.max(math.abs(normalized.X), math.abs(normalized.Y))
			if largest > 0.001 then
				normalized = normalized * (normalized.Magnitude / largest)
			end

			FH.CarSpeedRuntime.JoystickVector = Vector2.new(
				math.clamp(normalized.X, -1, 1),
				math.clamp(normalized.Y, -1, 1)
			)
		end

		local function beginSteeringJoystick(input)
			if not isPointerInput(input) or FH.CarSpeedRuntime.ActiveInput then return end
			FH.CarSpeedRuntime.ActiveInput = input
			FH.CarSpeedRuntime.DragInput = input
			FH.startJoystickCameraLock()
			updateSteeringJoystick(input)
		end

		joystick.InputBegan:Connect(beginSteeringJoystick)
		knob.InputBegan:Connect(beginSteeringJoystick)

		FH.CarSpeedRuntime.InputChangedConnection = UserInputService.InputChanged:Connect(function(input)
			local activeInput = FH.CarSpeedRuntime.ActiveInput
			if not activeInput then return end

			local isActiveTouch = input == activeInput
			local isActiveMouse = activeInput.UserInputType == Enum.UserInputType.MouseButton1
				and input.UserInputType == Enum.UserInputType.MouseMovement
			if isActiveTouch or isActiveMouse then
				updateSteeringJoystick(input)
			end
		end)

		FH.CarSpeedRuntime.InputEndedConnection = UserInputService.InputEnded:Connect(function(input)
			if FH.CarSpeedRuntime.ActiveInput == input then
				FH.CarSpeedRuntime.ActiveInput = nil
				FH.CarSpeedRuntime.DragInput = nil
				knob.Position = UDim2.fromScale(0.5, 0.5)
				FH.CarSpeedRuntime.JoystickVector = Vector2.new(0, 0)
				FH.stopJoystickCameraLock()
			end
		end)

		FH.updateVehicleJoystickVisibility()
	end

