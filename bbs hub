function FH.setEquippedItemsESP(enabled)
    FH.ESPEnabled = enabled == true
    if FH.ESPEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            FH.createBillboardForPlayer(player)
        end
        FH.ESPConnection = RunService.RenderStepped:Connect(function()
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local billboard = FH.BillboardCache[player]
                    if not billboard or not billboard.Parent then
                        FH.createBillboardForPlayer(player)
                    else
                        local char = player.Character
                        local anchor = FH.getEquippedESPAnchor(char)
                        if anchor then
                            if billboard.Adornee ~= anchor then
                                billboard.Adornee = anchor
                            end
                            billboard.StudsOffsetWorldSpace =
                                Vector3.new(0, FH.getESPWorldOffset(char), 0)
                            billboard.Enabled = true
                        else
                            billboard.Enabled = false
                        end
                    end
                end
            end
        end)
    else
        if FH.ESPConnection then
            FH.ESPConnection:Disconnect()
            FH.ESPConnection = nil
        end
        for player, billboard in pairs(FH.BillboardCache) do
            if billboard then
                billboard:Destroy()
            end
        end
        FH.BillboardCache = {}
    end
end

