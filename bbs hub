	local function findSearchRowFrame(control)
		if type(control) ~= "table" then return nil end

		local candidates = {}
		local elements = rawget(control, "UIElements")
		if type(elements) == "table" then
			candidates[#candidates + 1] = elements.Main
			candidates[#candidates + 1] = elements.Frame
		end
		candidates[#candidates + 1] = rawget(control, "Frame")
		candidates[#candidates + 1] = rawget(control, "ParagraphFrame")

		for _, candidate in ipairs(candidates) do
			if typeof(candidate) == "Instance" and candidate:IsA("GuiObject") then
				return candidate
			end
		end

		-- Si la version de WindUI usa otros nombres, se busca el primer
		-- GuiObject que el control tenga guardado.
		for _, value in pairs(control) do
			if typeof(value) == "Instance" and value:IsA("GuiObject") then
				return value
			end
			if type(value) == "table" then
				for _, inner in pairs(value) do
					if typeof(inner) == "Instance" and inner:IsA("GuiObject") then
						return inner
					end
				end
			end
		end
		return nil
	end

	local function applySearchFilter(query)
		query = string.lower(tostring(query or ""))
		local showAll = query:gsub("%s", "") == ""

		for _, entry in ipairs(FH.SearchIndex) do
			if entry.Row == nil then
				entry.Row = findSearchRowFrame(entry.Control) or false
			end
			if entry.Row then
				local haystack = string.lower(
					entry.Title .. " " .. entry.Desc .. " " .. tostring(entry.Tab)
				)
				local matches = showAll
					or string.find(haystack, query, 1, true) ~= nil
				pcall(function()
					entry.Row.Visible = matches
				end)
			end
		end
	end

	local function buildFunctionSearch()
		local windUIRoot = PlayerGui:FindFirstChild("WindUI")
		if not windUIRoot then return false end

		-- El titulo de la ventana sirve de ancla para colocar el buscador.
		local titleLabel
		for _, descendant in ipairs(windUIRoot:GetDescendants()) do
			if descendant:IsA("TextLabel")
				and descendant.Text == "BBSHUB"
			then
				titleLabel = descendant
				break
			end
		end
		if not titleLabel then return false end

		local topbar = titleLabel.Parent
		while topbar
			and topbar.Parent
			and topbar.Parent ~= windUIRoot
			and not topbar:FindFirstChildOfClass("UIListLayout")
			and topbar.AbsoluteSize.Y < 70
		do
			if topbar.Parent:IsA("GuiObject")
				and topbar.Parent.AbsoluteSize.Y >= 70
			then
				break
			end
			topbar = topbar.Parent
		end
		if not topbar or not topbar:IsA("GuiObject") then return false end

		local host = topbar.Parent
		if not host or not host:IsA("GuiObject") then return false end

		local existing = host:FindFirstChild("BBSSearchBar")
		if existing then existing:Destroy() end

		local bar = Instance.new("Frame")
		bar.Name = "BBSSearchBar"
		bar.Size = UDim2.new(1, -24, 0, 26)
		bar.Position = UDim2.new(
			0,
			12,
			0,
			math.max(topbar.AbsolutePosition.Y - host.AbsolutePosition.Y, 0)
				+ topbar.AbsoluteSize.Y
				+ 2
		)
		bar.BackgroundColor3 = Color3.fromRGB(32, 34, 44)
		bar.BackgroundTransparency = 0.25
		bar.BorderSizePixel = 0
		bar.ZIndex = 60
		bar.Parent = host
		Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 8)

		local barStroke = Instance.new("UIStroke", bar)
		barStroke.Color = Color3.fromRGB(255, 255, 255)
		barStroke.Thickness = 1
		barStroke.Transparency = 0.75

		-- Lupa a la izquierda, dibujada con dos formas para no depender de
		-- ninguna imagen.
		local glassHolder = Instance.new("Frame")
		glassHolder.Name = "SearchGlass"
		glassHolder.Size = UDim2.fromOffset(14, 14)
		glassHolder.Position = UDim2.new(0, 8, 0.5, -7)
