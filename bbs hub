	local function makeBadgeText(parent, name, text, bold, order)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.AutomaticSize = Enum.AutomaticSize.X
		label.Size = UDim2.new(0, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextSize = bold and 13 or 12
		label.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
		label.TextColor3 = bold
			and Color3.fromRGB(255, 255, 255)
			or Color3.fromRGB(168, 168, 168)
		label.LayoutOrder = order
		label.ZIndex = 10006
		label.Parent = parent
		return label
	end

	local function buildPerformanceBadge()
		if FH.PerformanceBadge and FH.PerformanceBadge.Parent then
			return FH.PerformanceBadge
		end

		local badge = Instance.new("Frame")
		badge.Name = "BBSPerformanceBadge"
		badge.AnchorPoint = Vector2.new(0.5, 0)
		-- Mismo tamano que la barra del panel tactil cerrado.
		badge.Size = UDim2.fromOffset(150, 26)
		badge.Position = UDim2.new(0.5, 150, 0, 12)
		badge.BackgroundColor3 = Color3.fromRGB(52, 52, 52)
		badge.BackgroundTransparency = 0.18
		badge.BorderSizePixel = 0
		badge.Active = true
		badge.ZIndex = 10005
		badge.Parent = RuntimeGui
		Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 8)

		local padding = Instance.new("UIPadding", badge)
		padding.PaddingLeft = UDim.new(0, 8)
		padding.PaddingRight = UDim.new(0, 8)

		local layout = Instance.new("UIListLayout", badge)
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 4)

		local fpsValue = makeBadgeText(badge, "FpsValue", "0", true, 1)
		makeBadgeText(badge, "FpsUnit", "fps", false, 2)

		-- Separacion extra a los lados del punto, como en la imagen.
		local dotHolder = Instance.new("Frame")
		dotHolder.Name = "DotHolder"
		dotHolder.Size = UDim2.new(0, 16, 1, 0)
		dotHolder.BackgroundTransparency = 1
		dotHolder.LayoutOrder = 3
		dotHolder.ZIndex = 10006
		dotHolder.Parent = badge

		local dot = Instance.new("Frame")
		dot.Name = "PingDot"
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = UDim2.fromScale(0.5, 0.5)
		dot.Size = UDim2.fromOffset(6, 6)
		dot.BackgroundColor3 = Color3.fromRGB(240, 185, 70)
		dot.BorderSizePixel = 0
		dot.ZIndex = 10007
		dot.Parent = dotHolder
		Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

		local pingValue = makeBadgeText(badge, "PingValue", "0", true, 4)
		makeBadgeText(badge, "PingUnit", "ms", false, 5)

		-- Arrastre propio, con mouse o con el dedo.
		local dragInput, dragStart, startPosition
		badge.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				dragInput = input
				dragStart = input.Position
				startPosition = badge.Position
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not dragInput then return end
			local matches = input == dragInput
				or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
					and input.UserInputType == Enum.UserInputType.MouseMovement)
			if not matches then return end
			local delta = input.Position - dragStart
			badge.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input == dragInput
				or (dragInput and input.UserInputType == Enum.UserInputType.MouseButton1)
			then
				dragInput = nil
			end
		end)

		FH.PerformanceBadge = badge
		FH.PerformanceBadgeParts = {
			Fps = fpsValue,
			Ping = pingValue,
			Dot = dot,
		}
		return badge
	end

	function FH.updatePerformanceBadge(fps, ping)
		local parts = FH.PerformanceBadgeParts
		if not parts then return end
		parts.Fps.Text = tostring(fps)
		parts.Ping.Text = tostring(ping)
		-- Verde con buen ping, amarillo regular, rojo malo.
		if ping < 80 then
			parts.Dot.BackgroundColor3 = Color3.fromRGB(90, 210, 120)
		elseif ping < 160 then
			parts.Dot.BackgroundColor3 = Color3.fromRGB(240, 185, 70)
		else
			parts.Dot.BackgroundColor3 = Color3.fromRGB(235, 85, 85)
		end
	end

