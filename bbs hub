function FH.normalizeRarityName(value)
	local text = string.lower(tostring(value or "Common"))
	local names = {
		common = "Common",
		uncommon = "Uncommon",
		rare = "Rare",
		epic = "Epic",
		legendary = "Legendary",
		omega = "Omega",
	}
	return names[text] or tostring(value or "Common")
end

function FH.isRecoilValueName(name)
	local normalized = string.lower(tostring(name))
	return string.find(normalized, "recoil", 1, true)
		or string.find(normalized, "kick", 1, true)
		or string.find(normalized, "camera_shake", 1, true)
		or string.find(normalized, "camerashake", 1, true)
		or string.find(normalized, "spread", 1, true)
end

function FH.restoreRecoilValues()
	for object, original in pairs(FH.RecoilOriginalValues) do
		if object and object.Parent then
			pcall(function()
				object.Value = original
			end)
		end
		FH.RecoilOriginalValues[object] = nil
	end
	for object, attributes in pairs(FH.RecoilOriginalAttributes) do
		if object and object.Parent then
			for name, original in pairs(attributes) do
				pcall(function()
					object:SetAttribute(name, original)
				end)
			end
		end
		FH.RecoilOriginalAttributes[object] = nil
	end
end

function FH.applyNoRecoilAttributes(object)
	if not object then return end
	for attributeName, attributeValue in pairs(object:GetAttributes()) do
		if FH.isRecoilValueName(attributeName)
			and (type(attributeValue) == "number"
				or typeof(attributeValue) == "Vector3"
				or typeof(attributeValue) == "CFrame")
		then
			FH.RecoilOriginalAttributes[object] = FH.RecoilOriginalAttributes[object] or {}
			if FH.RecoilOriginalAttributes[object][attributeName] == nil then
				FH.RecoilOriginalAttributes[object][attributeName] = attributeValue
			end
			pcall(function()
				local replacement
				if typeof(attributeValue) == "Vector3" then
					replacement = Vector3.zero
				elseif typeof(attributeValue) == "CFrame" then
					replacement = CFrame.identity
				else
					replacement = 0
				end
				if object:GetAttribute(attributeName) ~= replacement then
					object:SetAttribute(attributeName, replacement)
				end
			end)
		end
	end
end

function FH.applyNoRecoilTo(container)
	if not container then return end
	FH.applyNoRecoilAttributes(container)
	for _, object in ipairs(container:GetDescendants()) do
		if FH.isRecoilValueName(object.Name)
			and (object:IsA("NumberValue")
				or object:IsA("IntValue")
				or object:IsA("Vector3Value")
				or object:IsA("CFrameValue")
				or object:IsA("BoolValue"))
		then
			if FH.RecoilOriginalValues[object] == nil then
				FH.RecoilOriginalValues[object] = object.Value
			end
			pcall(function()
				local replacement = object:IsA("Vector3Value")
					and Vector3.zero
					or object:IsA("CFrameValue")
					and CFrame.identity
					or object:IsA("BoolValue")
					and false
					or 0
				if object.Value ~= replacement then
					object.Value = replacement
				end
			end)
		end
		FH.applyNoRecoilAttributes(object)
	end
end

function FH.setNoRecoil(enabled)
	FH.NoRecoil = enabled
	FH.NoRecoilRuntime.LastCharacter = nil
	FH.NoRecoilRuntime.LastBackpack = nil
	if not enabled then
		FH.restoreRecoilValues()
		return
	end
	local character = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	FH.applyNoRecoilTo(character)
	FH.applyNoRecoilTo(backpack)
end

