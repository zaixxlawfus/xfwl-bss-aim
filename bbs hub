-- SPEED HACK
-- Empuje por tiempo en la direccion en la que vas caminando. El factor es el
-- mismo del modulo original: (valor / 20) * 26 studs por segundo.
-- Animacion de correr. No se usan IDs fijos: se toma la animacion de correr
-- que el propio juego (Block Spin) tiene en el script Animate y se pone en el
-- grupo de caminar. Como la velocidad queda igual corriendo o caminando, asi
-- siempre se ve la animacion de correr del juego.
function FH.restartAnimateScript(character)
	local animate = character and character:FindFirstChild("Animate")
	if not animate then return end
	pcall(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				track:Stop(0)
			end
		end
		animate.Disabled = true
		task.wait()
		animate.Disabled = false
	end)
end

function FH.applySpeedHackRunAnimation(character)
	character = character or LocalPlayer.Character
	local animate = character and character:FindFirstChild("Animate")
	if not animate then return false end

	local runGroup = animate:FindFirstChild("run")
	local walkGroup = animate:FindFirstChild("walk")
	if not runGroup or not walkGroup then return false end

	local runId
	for _, anim in ipairs(runGroup:GetChildren()) do
		if anim:IsA("Animation") and anim.AnimationId ~= "" then
			runId = anim.AnimationId
			break
		end
	end
	if not runId then return false end

	local changed = false
	for _, anim in ipairs(walkGroup:GetChildren()) do
		if anim:IsA("Animation") and anim.AnimationId ~= runId then
			if FH.SpeedHackRuntime.OriginalWalkAnims[anim] == nil then
				FH.SpeedHackRuntime.OriginalWalkAnims[anim] = anim.AnimationId
			end
			pcall(function()
				anim.AnimationId = runId
			end)
			changed = true
		end
	end

	if changed then
		FH.restartAnimateScript(character)
	end
	return true
end

-- El script Animate le pone su propia velocidad a la animacion; aqui se le
-- sube un poco mas para que la carrera se vea un poco mas rapida.
function FH.speedUpSpeedHackAnimation(humanoid)
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end
	pcall(function()
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			local animation = track.Animation
			local name = string.lower(
				tostring(track.Name) .. " "
					.. tostring(animation and animation.Name or "") .. " "
					.. tostring(animation and animation.Parent and animation.Parent.Name or "")
			)
			if string.find(name, "walk", 1, true) or string.find(name, "run", 1, true) then
				track:AdjustSpeed(FH.SPEED_HACK_ANIM_SPEED)
			end
		end
	end)
end

function FH.restoreSpeedHackRunAnimation(character)
	local touched = false
	for anim, original in pairs(FH.SpeedHackRuntime.OriginalWalkAnims) do
		if anim and anim.Parent then
			pcall(function()
				anim.AnimationId = original
			end)
			touched = true
		end
		FH.SpeedHackRuntime.OriginalWalkAnims[anim] = nil
	end
	if touched then
		FH.restartAnimateScript(character or LocalPlayer.Character)
	end
end

function FH.stopSpeedHack()
	if FH.SpeedHackRuntime.Connection then
		FH.SpeedHackRuntime.Connection:Disconnect()
		FH.SpeedHackRuntime.Connection = nil
	end
	if FH.SpeedHackRuntime.WalkSpeedConnection then
		FH.SpeedHackRuntime.WalkSpeedConnection:Disconnect()
		FH.SpeedHackRuntime.WalkSpeedConnection = nil
	end
	if FH.SpeedHackRuntime.CharacterConnection then
		FH.SpeedHackRuntime.CharacterConnection:Disconnect()
		FH.SpeedHackRuntime.CharacterConnection = nil
	end
	FH.SpeedHackRuntime.Humanoid = nil
	FH.SpeedHackRuntime.BaseWalkSpeed = nil
end

-- Caminando se va a la velocidad de correr de Block Spin. El juego no la
-- dice en ningun lado, asi que se aprende: es la WalkSpeed mas alta que se le
-- ve al personaje al esprintar. Desde ahi, cada vez que el juego la baja (al
-- soltar el boton de correr) se le regresa a esa. Encima se suma el extra.
function FH.holdSpeedHackWalkSpeed(humanoid)
	if not humanoid then return end
	-- Sentado manda Speed Cars, que tambien usa la WalkSpeed.
	if humanoid.SeatPart then return end

	local current = humanoid.WalkSpeed
	if type(current) ~= "number" then return end
	-- Golpes y aturdimientos la bajan casi a cero: se dejan pasar.
	if current < FH.SPEED_HACK_BASE_FLOOR then return end

	local runtime = FH.SpeedHackRuntime
	local base = runtime.BaseWalkSpeed
	if not base or current < base then
		runtime.BaseWalkSpeed = current
		base = current
	end

	if current > base + 0.5
		and current <= base * FH.SPEED_HACK_MAX_SPRINT_RATIO
		and current > (runtime.SprintWalkSpeed or 0)
	then
		runtime.SprintWalkSpeed = current
	end

	local sprint = runtime.SprintWalkSpeed
	if sprint and current < sprint - 0.05 then
		pcall(function()
			humanoid.WalkSpeed = sprint
		end)
	end
end

function FH.bindSpeedHackHumanoid(humanoid)
	if FH.SpeedHackRuntime.Humanoid == humanoid then return end

	if FH.SpeedHackRuntime.WalkSpeedConnection then
		FH.SpeedHackRuntime.WalkSpeedConnection:Disconnect()
		FH.SpeedHackRuntime.WalkSpeedConnection = nil
	end
	FH.SpeedHackRuntime.Humanoid = humanoid
	FH.SpeedHackRuntime.BaseWalkSpeed = nil
	if not humanoid then return end

	-- Se corrige en cuanto el juego cambia la velocidad, sin esperar al
	-- siguiente frame, para que no alcance a notarse el tiron de la carrera.
	FH.SpeedHackRuntime.WalkSpeedConnection =
		humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if FH.SpeedHackEnabled then
				FH.holdSpeedHackWalkSpeed(humanoid)
			end
		end)
	FH.holdSpeedHackWalkSpeed(humanoid)
end

function FH.setSpeedHack(enabled)
	FH.SpeedHackEnabled = enabled == true
	FH.stopSpeedHack()
	if not FH.SpeedHackEnabled then
		task.spawn(function()
			pcall(FH.restoreSpeedHackRunAnimation, LocalPlayer.Character)
		end)
		return
	end

	task.spawn(function()
		pcall(FH.applySpeedHackRunAnimation, LocalPlayer.Character)
	end)
	-- Al reaparecer el juego trae un Animate nuevo: se vuelve a aplicar.
	FH.SpeedHackRuntime.CharacterConnection =
		LocalPlayer.CharacterAdded:Connect(function(character)
			if not FH.SpeedHackEnabled then return end
			task.spawn(function()
				character:WaitForChild("Animate", 10)
				task.wait(0.4)
				if FH.SpeedHackEnabled and LocalPlayer.Character == character then
					pcall(FH.applySpeedHackRunAnimation, character)
				end
			end)
		end)

	FH.SpeedHackRuntime.Connection = RunService.RenderStepped:Connect(function(deltaTime)
		if not FH.SpeedHackEnabled then return end

		local character = LocalPlayer.Character
		if not character then return end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not root then return end

		FH.bindSpeedHackHumanoid(humanoid)
		if humanoid.SeatPart then return end
		FH.holdSpeedHackWalkSpeed(humanoid)

		local moveDirection = humanoid.MoveDirection
		if moveDirection.Magnitude <= 0 then return end

		FH.speedUpSpeedHackAnimation(humanoid)

		local amount = math.clamp(tonumber(FH.SpeedHackValue) or 7, 1, 20)
		local step = (amount / 20)
			* 26
			* math.min(tonumber(deltaTime) or 0, 1 / 20)

		local move = moveDirection.Unit * step
		root.CFrame = root.CFrame + Vector3.new(move.X, 0, move.Z)
	end)
end

-- JUMP POWER
-- Cada vez que se pide un salto, se fuerza el estado de salto y se le pone al
-- personaje una velocidad vertical fija, asi que se puede saltar en el aire.
function FH.stopJumpPower()
	if FH.JumpPowerRuntime.Connection then
		FH.JumpPowerRuntime.Connection:Disconnect()
		FH.JumpPowerRuntime.Connection = nil
	end
end

function FH.setJumpPower(enabled)
	FH.JumpPowerEnabled = enabled == true
	FH.stopJumpPower()
	if not FH.JumpPowerEnabled then return end

	FH.JumpPowerRuntime.Connection = UserInputService.JumpRequest:Connect(function()
		if not FH.JumpPowerEnabled then return end

		pcall(function()
			local character = LocalPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not humanoid or not root then return end
			if humanoid.Health <= 0 then return end

			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(
				velocity.X,
				FH.JUMP_POWER_VALUE,
				velocity.Z
			)
		end)
	end)
end

function FH.getCurrentVehicle()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
		local seatedVehicle = seat:FindFirstAncestorOfClass("Model")
		if seatedVehicle then
			return seatedVehicle, seat
		end
	end

	local vehicleFolder = Workspace:FindFirstChild("Vehicles")
	if vehicleFolder then
		for _, vehicle in ipairs(vehicleFolder:GetChildren()) do
			if vehicle:IsA("Model") then
				local owner = vehicle:GetAttribute("OwnerUserId")
				if owner and tonumber(owner) == LocalPlayer.UserId then
					return vehicle, nil
				end
			end
		end
	end
	return nil, nil
end

function FH.destroyCarModsSupport()
	for _, support in ipairs(FH.CarSpeedRuntime.SupportParts or {}) do
		if support and support.Parent then
			pcall(function()
				support:Destroy()
			end)
		end
	end
	FH.CarSpeedRuntime.SupportParts = {}
end

function FH.restoreCarSpeedLimits()
	local humanoid = FH.CarSpeedRuntime.SpeedHumanoid
	if humanoid and humanoid.Parent and FH.CarSpeedRuntime.OriginalWalkSpeed then
		pcall(function()
			humanoid.WalkSpeed = FH.CarSpeedRuntime.OriginalWalkSpeed
		end)
	end
	FH.CarSpeedRuntime.SpeedHumanoid = nil
	FH.CarSpeedRuntime.OriginalWalkSpeed = nil

	local seat = FH.CarSpeedRuntime.SpeedSeat
	if seat and seat.Parent and FH.CarSpeedRuntime.OriginalSeatMaxSpeed then
		pcall(function()
			seat.MaxSpeed = FH.CarSpeedRuntime.OriginalSeatMaxSpeed
		end)
	end
	FH.CarSpeedRuntime.SpeedSeat = nil
	FH.CarSpeedRuntime.OriginalSeatMaxSpeed = nil
end

function FH.restoreCarVehicleState()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("VectorForce")
			and descendant.Name == "BBSHubCarHoverForce"
		then
			pcall(function()
				descendant:Destroy()
			end)
		elseif descendant:IsA("Attachment")
			and descendant.Name == "BBSHubCarHoverAttachment"
		then
			pcall(function()
				descendant:Destroy()
			end)
		elseif descendant:IsA("BasePart")
			and descendant.Name == "BBSHubCarLegSupport"
		then
			pcall(function()
				descendant:Destroy()
			end)
		end
	end
end

function FH.updateCarModsSupport(character, seat)
	FH.destroyCarModsSupport()
end

function FH.getVehicleInput(seat)
	local joystick = FH.CarSpeedRuntime.JoystickVector or Vector2.new(0, 0)
	local joystickActive = joystick.Magnitude >= 0.08
	if not joystickActive then return 0, 0 end

	return math.clamp(-joystick.Y, -1, 1), math.clamp(-joystick.X, -1, 1)
end

function FH.isVehicleJoystickActive()
	local joystick = FH.CarSpeedRuntime.JoystickVector
	return joystick and joystick.Magnitude >= 0.08
end

-- El Snap Car mueve el carro por su cuenta (PivotTo + velocidad). Si Speed
-- Cars tambien le aplica fisica al mismo tiempo, los dos pelean: la camara
-- brinca de un lado a otro y a ratos el carro no avanza. Mientras el Snap Car
-- maneje, Speed Cars solo le pasa el joystick y la velocidad maxima.
function FH.isSnapCarDriving()
	local getState = FH.getSnapCarState
	if type(getState) ~= "function" then return false end
	local ok, state = pcall(getState)
	if not ok or type(state) ~= "table" then return false end
	return state.Enabled == true or state.Exiting == true
end

function FH.applyCarVehicleSpeed(vehicle, seat, deltaTime)
	if not vehicle or not seat or not seat.Parent then return end

	local forcePart = seat.AssemblyRootPart
		or vehicle.PrimaryPart
		or seat
	if not forcePart or not forcePart:IsA("BasePart") then return end

	local throttle, steer = FH.getVehicleInput(seat)

	local lookVector = seat.CFrame.LookVector
	local direction = Vector3.new(
		lookVector.X * throttle,
		0,
		lookVector.Z * throttle
	)

	local currentVelocity = forcePart.AssemblyLinearVelocity
	local horizontalVelocity = Vector3.new(
		currentVelocity.X,
		0,
		currentVelocity.Z
	)
	local targetSpeed = math.clamp(FH.CarPlayerSpeed, 1, 250)
	local elapsed = math.max(tonumber(deltaTime) or 0, 1 / 240)

	-- Al soltar los botones de adelante/atras el carro frena por su cuenta,
	-- pero de forma progresiva: un corte seco de velocidad cuenta como golpe
	-- para la fisica y le hace daño al vehiculo.
	if math.abs(throttle) < 0.08 then
		local brakeAlpha = math.clamp(FH.CAR_BRAKE_RESPONSE * elapsed, 0, 1)
		local slowed = horizontalVelocity * (1 - brakeAlpha)
		if slowed.Magnitude <= FH.CAR_BRAKE_MIN_SPEED then
			slowed = Vector3.new(0, 0, 0)
		end
		pcall(function()
			local brakeVelocity = forcePart.AssemblyLinearVelocity
			forcePart.AssemblyLinearVelocity = Vector3.new(
				slowed.X,
				brakeVelocity.Y,
				slowed.Z
			)
			local spin = forcePart.AssemblyAngularVelocity
			forcePart.AssemblyAngularVelocity = spin * (1 - brakeAlpha)
		end)
		horizontalVelocity = slowed
	end

	if math.abs(throttle) >= 0.08 and direction.Magnitude >= 0.01 then
		direction = direction.Unit
		local currentForwardSpeed = horizontalVelocity:Dot(direction)
		local speedDifference = targetSpeed - currentForwardSpeed
		if speedDifference > 0 then
			local acceleration = math.clamp(targetSpeed * 4, 20, 600)
			local impulseSpeed = math.min(speedDifference, acceleration * elapsed)
			pcall(function()
				forcePart:ApplyImpulse(
					direction * impulseSpeed * forcePart.AssemblyMass
				)
			end)
		end
	end

	local angularVelocity = forcePart.AssemblyAngularVelocity
	local targetTurnRate = 0
	if math.abs(steer) >= 0.08 then
		if horizontalVelocity.Magnitude >= FH.CAR_STEERING_MIN_SPEED then
			local forwardSign = horizontalVelocity:Dot(seat.CFrame.LookVector) >= 0
				and 1
				or -1
			targetTurnRate = steer * forwardSign * FH.CAR_MAX_TURN_RATE
		else
			-- Parado tambien gira, un poco mas lento, para poder acomodar
			-- el carro sin tener que avanzar.
			targetTurnRate = steer * FH.CAR_STATIONARY_TURN_RATE
		end
	end

	local turnAlpha = math.clamp(FH.CAR_STEERING_RESPONSE * elapsed, 0, 1)
	local nextTurnRate = angularVelocity.Y
		+ (targetTurnRate - angularVelocity.Y) * turnAlpha
	pcall(function()
		forcePart.AssemblyAngularVelocity = Vector3.new(
			angularVelocity.X,
			nextTurnRate,
			angularVelocity.Z
		)
	end)

	local horizontalRight = Vector3.new(
		forcePart.CFrame.RightVector.X,
		0,
		forcePart.CFrame.RightVector.Z
	)
	if horizontalRight.Magnitude >= 0.05 then
		local lateralSpeed = horizontalVelocity:Dot(horizontalRight.Unit)
		if math.abs(lateralSpeed) > 0.01 then
			local gripAlpha = math.clamp(
				FH.CAR_DRIFT_GRIP_RESPONSE * elapsed,
				0,
				1
			)
			local correctionSpeed = lateralSpeed * gripAlpha
			pcall(function()
				forcePart:ApplyImpulse(
					-horizontalRight.Unit
						* correctionSpeed
						* forcePart.AssemblyMass
				)
			end)
		end
	end

	-- Estabilizacion sin tocar el CFrame. Antes se le reescribia la
	-- orientacion al carro en cada frame, y como la camara sigue al carro,
	-- cada uno de esos saltos la sacudia. Ahora la inclinacion se corrige con
	-- velocidad angular: la fisica lo endereza y la camara se mueve suave.
	local up = forcePart.CFrame.UpVector
	local axis = up:Cross(Vector3.new(0, 1, 0))
	local sinAngle = math.clamp(axis.Magnitude, 0, 1)
	local tiltAngle = math.asin(sinAngle)
	if up.Y < 0 then
		tiltAngle = math.pi - tiltAngle
	end

	local tiltCorrection = Vector3.new(0, 0, 0)
	if sinAngle > 1e-4 then
		tiltCorrection = axis.Unit
			* math.min(tiltAngle * FH.CAR_UPRIGHT_GAIN, FH.CAR_UPRIGHT_MAX_RATE)
	end

	pcall(function()
		forcePart.AssemblyAngularVelocity = Vector3.new(
			tiltCorrection.X,
			nextTurnRate,
			tiltCorrection.Z
		)
	end)

	-- Las llantas son ensamblajes aparte: conservan el giro sobre su eje
	-- (para seguir rodando), acompañan el volante y se les quita el ladeo.
	local axle = forcePart.CFrame.RightVector
	FH.forEachVehicleAssembly(vehicle, function(assemblyRoot)
		if assemblyRoot == forcePart then return end
		local spin = assemblyRoot.AssemblyAngularVelocity
		local rolling = axle * spin:Dot(axle)
		assemblyRoot.AssemblyAngularVelocity = rolling
			+ Vector3.new(tiltCorrection.X, nextTurnRate, tiltCorrection.Z)
	end)
end

function FH.applyCarPlayerSpeed()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	local seated = seat
		and (seat:IsA("VehicleSeat") or seat:IsA("Seat"))
	if not humanoid or humanoid.Health <= 0 or not seated then
		FH.restoreCarSpeedLimits()
		FH.updateCarModsSupport(character, nil)
		return
	end

	if FH.CarSpeedRuntime.SpeedHumanoid ~= humanoid then
		FH.restoreCarSpeedLimits()
		FH.CarSpeedRuntime.SpeedHumanoid = humanoid
		FH.CarSpeedRuntime.OriginalWalkSpeed = humanoid.WalkSpeed
	end
	pcall(function()
		humanoid.WalkSpeed = math.clamp(FH.CarPlayerSpeed, 1, 250)
	end)

	if seat:IsA("VehicleSeat") then
		if FH.CarSpeedRuntime.SpeedSeat ~= seat then
			if FH.CarSpeedRuntime.SpeedSeat then
				FH.restoreCarSpeedLimits()
				FH.CarSpeedRuntime.SpeedHumanoid = humanoid
				FH.CarSpeedRuntime.OriginalWalkSpeed = humanoid.WalkSpeed
			end
			FH.CarSpeedRuntime.SpeedSeat = seat
			FH.CarSpeedRuntime.OriginalSeatMaxSpeed = seat.MaxSpeed
		end
		pcall(function()
			seat.MaxSpeed = math.clamp(FH.CarPlayerSpeed, 1, 250)
		end)
	end
	FH.updateCarModsSupport(character, seat)
end

-- Mientras el dedo esta en el joystick, la camara no gira. Se guarda hacia
-- donde miraba al tocarlo y, justo despues de que el modulo de camara de
-- Roblox hace lo suyo en cada frame, se le regresa esa direccion. Sigue al
-- carro (la posicion se mueve), pero no gira ni por el dedo ni por las curvas.
FH.JOYSTICK_CAMERA_LOCK = "BBSJoystickCameraLock"
FH.JoystickCameraLook = nil

function FH.stopJoystickCameraLock()
	if FH.JoystickCameraLook then
		pcall(function()
			RunService:UnbindFromRenderStep(FH.JOYSTICK_CAMERA_LOCK)
		end)
	end
	FH.JoystickCameraLook = nil
end

function FH.startJoystickCameraLock()
	local camera = Workspace.CurrentCamera
	if not camera then return end
	FH.stopJoystickCameraLock()
	FH.JoystickCameraLook = camera.CFrame.LookVector

	pcall(function()
		RunService:BindToRenderStep(
			FH.JOYSTICK_CAMERA_LOCK,
			Enum.RenderPriority.Camera.Value + 1,
			function()
				local look = FH.JoystickCameraLook
				local cam = Workspace.CurrentCamera
				if not look or not cam then return end
				local focus = cam.Focus.Position
				local distance = (cam.CFrame.Position - focus).Magnitude
				if distance < 0.5 then return end
				cam.CFrame = CFrame.lookAt(focus - look * distance, focus)
			end
		)
	end)
end

function FH.resetVehicleJoystick()
	FH.stopJoystickCameraLock()
	FH.CarSpeedRuntime.JoystickVector = Vector2.new(0, 0)
	FH.CarSpeedRuntime.ActiveInput = nil
	FH.CarSpeedRuntime.DragInput = nil
	if FH.CarSpeedRuntime.JoystickKnob then
		FH.CarSpeedRuntime.JoystickKnob.Position = UDim2.fromScale(0.5, 0.5)
	end
end

function FH.updateVehicleJoystickVisibility()
	local joystick = FH.CarSpeedRuntime.MiniButton
	if not joystick or not joystick.Parent then
		return
	end

	local _, seat = FH.getCurrentVehicle()
	local seated = seat
		and (seat:IsA("VehicleSeat") or seat:IsA("Seat"))
	local shouldShow = FH.CarModsEnabled and seated == true
	joystick.Visible = shouldShow
	if not shouldShow then
		FH.resetVehicleJoystick()
	end
end

function FH.applyCarControl()
	if not FH.CarModsEnabled then return end

	local _, seat = FH.getCurrentVehicle()
	if not seat
		or not (seat:IsA("VehicleSeat") or seat:IsA("Seat"))
	then
		FH.updateVehicleJoystickVisibility()
		return
	end

	FH.updateVehicleJoystickVisibility()
	if not FH.isVehicleJoystickActive() then
		pcall(function()
			seat.ThrottleFloat = 0
		end)
		pcall(function()
			seat.SteerFloat = 0
		end)
		pcall(function()
			seat.Throttle = 0
		end)
		pcall(function()
			seat.Steer = 0
		end)
		return
	end

	local throttle, steer = FH.getVehicleInput(seat)
	local throttleInt = math.abs(throttle) < 0.08 and 0 or (throttle > 0 and 1 or -1)
	local steerInt = math.abs(steer) < 0.08 and 0 or (steer > 0 and 1 or -1)

	pcall(function()
		seat.ThrottleFloat = throttle
	end)
	pcall(function()
		seat.SteerFloat = steer
	end)
	pcall(function()
		seat.Throttle = throttleInt
	end)
	pcall(function()
		seat.Steer = steerInt
	end)
end

function FH.getCarRaycastParams(storage, key, vehicle)
	local params = storage[key]
	if not params then
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.IgnoreWater = true
		storage[key] = params
	end
	local filter = {vehicle}
	local character = LocalPlayer.Character
	if character then
		filter[#filter + 1] = character
	end
	local flyPlatform = FH.FlyCarRuntime and FH.FlyCarRuntime.Platform
	if flyPlatform and flyPlatform.Parent then
		filter[#filter + 1] = flyPlatform
	end
	params.FilterDescendantsInstances = filter
	return params
end

function FH.getCarExtents(vehicle)
	local ok, size = pcall(function()
		return vehicle:GetExtentsSize()
	end)
	if ok and typeof(size) == "Vector3" then
		return math.max(size.X, size.Z) / 2, size.Y / 2
	end
	return 4, 2
end

-- Las llantas suelen ser ensamblajes aparte de la carroceria, asi que recorre
-- todos los ensamblajes del vehiculo para tratar al carro entero junto.
function FH.forEachVehicleAssembly(vehicle, handler)
	local ok, descendants = pcall(function()
		return vehicle:GetDescendants()
	end)
	if not ok or type(descendants) ~= "table" then return end

	local visited = {}
	for _, descendant in ipairs(descendants) do
		if descendant:IsA("BasePart") then
			local root = descendant.AssemblyRootPart or descendant
			if not visited[root] and not root.Anchored then
				visited[root] = true
				pcall(handler, root)
			end
		end
	end
end

function FH.stopCarSpeed()
	if FH.CarSpeedRuntime.Connection then
		FH.CarSpeedRuntime.Connection:Disconnect()
		FH.CarSpeedRuntime.Connection = nil
	end
	FH.restoreCarSpeedLimits()
	FH.restoreCarVehicleState()
	FH.destroyCarModsSupport()
	FH.resetVehicleJoystick()
	FH.updateVehicleJoystickVisibility()
end

function FH.setCarSpeed(enabled)
	FH.CarModsEnabled = enabled == true
	FH.stopCarSpeed()
	if not FH.CarModsEnabled then return end
	FH.updateVehicleJoystickVisibility()
	FH.CarSpeedRuntime.Connection = RunService.Heartbeat:Connect(function(deltaTime)
		pcall(function()
			local vehicle, seat = FH.getCurrentVehicle()
			FH.applyCarPlayerSpeed()
			FH.applyCarControl()
			if FH.isSnapCarDriving() then return end
			FH.applyCarVehicleSpeed(vehicle, seat, deltaTime)
		end)
	end)
end

-- ==========================================
-- FLY CAR
-- Sale una plataforma debajo del carro y lo sube a la altura del slider. La
-- plataforma sigue al carro, asi que manejas encima de ella como si fuera el
-- piso, y sube o baja sola siguiendo el terreno que hay abajo.
-- ==========================================
function FH.destroyFlyCarPlatform()
	local platform = FH.FlyCarRuntime.Platform
	if platform then
		pcall(function()
			platform:Destroy()
		end)
	end
	FH.FlyCarRuntime.Platform = nil
	FH.FlyCarRuntime.PlatformTop = nil
	FH.FlyCarRuntime.GroundY = nil
	FH.FlyCarRuntime.OffSince = nil
end

function FH.createFlyCarPlatform()
	local platform = Instance.new("Part")
	platform.Name = "BBSFlyCarPlatform"
	platform.Anchored = true
	platform.CanCollide = true
	platform.CanTouch = false
	platform.CanQuery = false
	platform.CastShadow = false
	platform.Material = Enum.Material.Glass
	platform.Color = Color3.fromRGB(80, 155, 255)
	platform.Transparency = 0.55
	platform.Size = Vector3.new(14, 1, 18)
	platform.TopSurface = Enum.SurfaceType.Smooth
	platform.BottomSurface = Enum.SurfaceType.Smooth
	platform.Parent = Workspace
	FH.FlyCarRuntime.Platform = platform
	return platform
end

-- Mueve todo el carro (carroceria y llantas) a la misma velocidad vertical
-- que la plataforma, para que suba con ella en vez de que lo empuje de golpe.
function FH.setVehicleVerticalSpeed(vehicle, speed)
	FH.forEachVehicleAssembly(vehicle, function(root)
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(velocity.X, speed, velocity.Z)
	end)
end

-- El carro no debe despegarse hacia arriba: si va mas rapido hacia arriba que
-- la plataforma, se le recorta esa velocidad. Eso era lo que lo hacia
-- brincar cuando la plataforma dejaba de subir.
function FH.capVehicleRise(vehicle, maxUpSpeed)
	FH.forEachVehicleAssembly(vehicle, function(root)
		local velocity = root.AssemblyLinearVelocity
		if velocity.Y > maxUpSpeed then
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, maxUpSpeed, velocity.Z)
		end
	end)
end

function FH.recoverFlyCar(vehicle, boxCFrame, boxSize, platformTop)
	local look = boxCFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.05 then
		flatLook = Vector3.new(0, 0, -1)
	end

	local okPivot, pivot = pcall(function()
		return vehicle:GetPivot()
	end)
	if not okPivot or typeof(pivot) ~= "CFrame" then return end

	-- Se deja derecho, con la base apenas arriba de la plataforma.
	local center = boxCFrame.Position
	local uprightCenter = Vector3.new(center.X, platformTop + boxSize.Y / 2 + 0.2, center.Z)
	local uprightBox = CFrame.lookAt(uprightCenter, uprightCenter + flatLook.Unit)
	local pivotOffset = boxCFrame:ToObjectSpace(pivot)

	pcall(function()
		vehicle:PivotTo(uprightBox * pivotOffset)
	end)
	FH.forEachVehicleAssembly(vehicle, function(root)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end)
end

function FH.updateFlyCar(deltaTime)
	local vehicle, seat = FH.getCurrentVehicle()
	if not vehicle or not vehicle.Parent or FH.isSnapCarDriving() then
		FH.destroyFlyCarPlatform()
		return
	end

	local okBox, boxCFrame, boxSize = pcall(function()
		return vehicle:GetBoundingBox()
	end)
	if not okBox or typeof(boxCFrame) ~= "CFrame" then return end

	local center = boxCFrame.Position
	local bottomY = center.Y - boxSize.Y / 2

	-- Piso real debajo del carro, sin contar el carro ni la plataforma.
	local params = FH.getCarRaycastParams(FH.FlyCarRuntime, "RaycastParams", vehicle)
	local hit = Workspace:Raycast(center, Vector3.new(0, -600, 0), params)
	if hit then
		FH.FlyCarRuntime.GroundY = hit.Position.Y
	end
	local groundY = FH.FlyCarRuntime.GroundY or (bottomY - 0.5)

	-- Apagado: la plataforma baja al piso y despues desaparece.
	local targetTop = FH.FlyCarEnabled
		and groundY + math.clamp(
			tonumber(FH.FlyCarHeight) or 3,
			FH.FLY_CAR_MIN_HEIGHT,
			FH.FLY_CAR_MAX_HEIGHT
		)
		or groundY

	local platform = FH.FlyCarRuntime.Platform
	if not platform or not platform.Parent then
		if not FH.FlyCarEnabled then return end
		platform = FH.createFlyCarPlatform()
		-- Arranca justo debajo de las llantas para no atravesar el carro.
		FH.FlyCarRuntime.PlatformTop = math.min(bottomY, targetTop)
	end

	local currentTop = FH.FlyCarRuntime.PlatformTop or bottomY
	local step = FH.FLY_CAR_RISE_SPEED * math.min(tonumber(deltaTime) or 0, 1 / 20)
	local nextTop
	local verticalSpeed = 0
	if currentTop < targetTop then
		nextTop = math.min(currentTop + step, targetTop)
		verticalSpeed = FH.FLY_CAR_RISE_SPEED
	elseif currentTop > targetTop then
		nextTop = math.max(currentTop - step, targetTop)
		verticalSpeed = -FH.FLY_CAR_RISE_SPEED
	else
		nextTop = currentTop
	end
	FH.FlyCarRuntime.PlatformTop = nextTop

	local onPlatform = math.abs(bottomY - currentTop) < 2.5
	if verticalSpeed ~= 0 and onPlatform then
		FH.setVehicleVerticalSpeed(vehicle, verticalSpeed)
	end
	if onPlatform then
		FH.capVehicleRise(vehicle, math.max(verticalSpeed, 0))
	end

	-- Caido por debajo, lanzado muy arriba o volcado: si dura un segundo, se
	-- repone encima de la plataforma.
	if FH.FlyCarEnabled then
		local upright = boxCFrame.UpVector.Y
		local fellBelow = bottomY < nextTop - 1.5
		local launched = bottomY > nextTop + 6
		local flipped = upright < 0.35
		if fellBelow or launched or flipped then
			local now = os.clock()
			FH.FlyCarRuntime.OffSince = FH.FlyCarRuntime.OffSince or now
			if now - FH.FlyCarRuntime.OffSince >= FH.FLY_CAR_RECOVER_DELAY then
				FH.FlyCarRuntime.OffSince = nil
				FH.recoverFlyCar(vehicle, boxCFrame, boxSize, nextTop)
			end
		else
			FH.FlyCarRuntime.OffSince = nil
		end
	end

	-- La plataforma se acomoda bajo el carro con el mismo giro horizontal.
	local look = boxCFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.05 then
		flatLook = Vector3.new(0, 0, -1)
	end
	pcall(function()
		platform.Size = Vector3.new(
			math.max(boxSize.X, 6) + 8,
			1,
			math.max(boxSize.Z, 8) + 8
		)
		platform.CFrame = CFrame.lookAt(
			Vector3.new(center.X, nextTop - 0.5, center.Z),
			Vector3.new(center.X, nextTop - 0.5, center.Z) + flatLook.Unit
		)
	end)

	if not FH.FlyCarEnabled and nextTop <= groundY + 0.05 then
		FH.destroyFlyCarPlatform()
		if FH.FlyCarRuntime.Connection then
			FH.FlyCarRuntime.Connection:Disconnect()
			FH.FlyCarRuntime.Connection = nil
		end
	end
end

function FH.setFlyCar(enabled)
	FH.FlyCarEnabled = enabled == true
	-- Al apagar no se corta el ciclo: sigue hasta bajar el carro al piso.
	if FH.FlyCarRuntime.Connection then return end
	if not FH.FlyCarEnabled then
		FH.destroyFlyCarPlatform()
		return
	end
	FH.FlyCarRuntime.Connection = RunService.Heartbeat:Connect(function(deltaTime)
		pcall(FH.updateFlyCar, deltaTime)
	end)
end

function FH.getCarArmorImpactCap()
	local reduction = FH.CAR_ARMOR_REDUCTION
	return FH.CAR_ARMOR_MAX_IMPACT_SPEED
		+ (FH.CAR_ARMOR_MIN_IMPACT_SPEED - FH.CAR_ARMOR_MAX_IMPACT_SPEED) * reduction
end

function FH.isCarHealthName(name)
	local normalized = string.lower(tostring(name or ""))
	if normalized == "" then return false, false end
	for _, pattern in ipairs(FH.CAR_ARMOR_HEALTH_PATTERNS) do
		if string.find(normalized, pattern, 1, true) then
			return true, pattern == "damage"
		end
	end
	return false, false
end

function FH.addCarHealthSource(sources, object, attributeName, value, inverted)
	if type(value) ~= "number" then return end
	sources[#sources + 1] = {
		Object = object,
		Attribute = attributeName,
		Inverted = inverted == true,
		Last = value,
	}
end

function FH.scanCarHealthSources(vehicle)
	local sources = {}
	if not vehicle then return sources end

	local function scanObject(object)
		local attributesOk, attributes = pcall(function()
			return object:GetAttributes()
		end)
		if attributesOk and type(attributes) == "table" then
			for attributeName, attributeValue in pairs(attributes) do
				local matches, inverted = FH.isCarHealthName(attributeName)
				if matches then
					FH.addCarHealthSource(
						sources,
						object,
						attributeName,
						attributeValue,
						inverted
					)
				end
			end
		end
		if object:IsA("NumberValue") or object:IsA("IntValue") then
			local matches, inverted = FH.isCarHealthName(object.Name)
			if matches then
				FH.addCarHealthSource(sources, object, nil, object.Value, inverted)
			end
		end
	end

	scanObject(vehicle)
	local descendantsOk, descendants = pcall(function()
		return vehicle:GetDescendants()
	end)
	if descendantsOk and type(descendants) == "table" then
		for _, descendant in ipairs(descendants) do
			pcall(scanObject, descendant)
		end
	end
	return sources
end

function FH.readCarHealthSource(source)
	local ok, value
	if source.Attribute then
		ok, value = pcall(function()
			return source.Object:GetAttribute(source.Attribute)
		end)
	else
		ok, value = pcall(function()
			return source.Object.Value
		end)
	end
	if not ok or type(value) ~= "number" then return nil end
	return value
end

function FH.writeCarHealthSource(source, value)
	if source.Attribute then
		return pcall(function()
			source.Object:SetAttribute(source.Attribute, value)
		end)
	end
	return pcall(function()
		source.Object.Value = value
	end)
end

-- Devuelve una parte del daño recibido: el carro sigue sufriendo, pero mucho
-- menos. Si el juego lleva la vida del vehiculo solo en el servidor, esta capa
-- no alcanza a pegar y la que trabaja es el amortiguado de impactos.
function FH.softenCarHealthLoss(vehicle, now)
	if now >= (FH.CarArmorRuntime.HealthScanAt or 0)
		or FH.CarArmorRuntime.Vehicle ~= vehicle
	then
		FH.CarArmorRuntime.HealthScanAt = now + 2
		FH.CarArmorRuntime.HealthSources = FH.scanCarHealthSources(vehicle)
	end

	local reduction = FH.CAR_ARMOR_REDUCTION
	for _, source in ipairs(FH.CarArmorRuntime.HealthSources) do
		if source.Object and source.Object.Parent then
			local current = FH.readCarHealthSource(source)
			if current then
				local lost = source.Inverted
					and (current - source.Last)
					or (source.Last - current)
				if lost > 0.001 then
					local refund = lost * reduction
					local restored = source.Inverted
						and (current - refund)
						or (current + refund)
					if FH.writeCarHealthSource(source, restored) then
						source.Last = FH.readCarHealthSource(source) or restored
					else
						source.Last = current
					end
				else
					source.Last = current
				end
			end
		end
	end
end

function FH.getCarArmorRaycastParams(vehicle)
	return FH.getCarRaycastParams(FH.CarArmorRuntime, "RaycastParams", vehicle)
end

-- La colision del carro queda solo en la carroceria: los asientos del
-- conductor y de los pasajeros dejan de chocar con nada.
function FH.restoreCarSeatCollision()
	for seat, original in pairs(FH.CarSeatRuntime.Seats) do
		if seat and seat.Parent then
			pcall(function()
				seat.CanCollide = original
			end)
		end
		FH.CarSeatRuntime.Seats[seat] = nil
	end
	FH.CarSeatRuntime.Seats = {}
	FH.CarSeatRuntime.Vehicle = nil
end

function FH.applyCarSeatCollision(vehicle)
	if FH.CarSeatRuntime.Vehicle ~= vehicle then
		FH.restoreCarSeatCollision()
		FH.CarSeatRuntime.Vehicle = vehicle
	end

	local ok, descendants = pcall(function()
		return vehicle:GetDescendants()
	end)
	if not ok or type(descendants) ~= "table" then return end

	for _, descendant in ipairs(descendants) do
		if (descendant:IsA("VehicleSeat") or descendant:IsA("Seat"))
			and descendant.CanCollide
		then
			if FH.CarSeatRuntime.Seats[descendant] == nil then
				FH.CarSeatRuntime.Seats[descendant] = descendant.CanCollide
			end
			pcall(function()
				descendant.CanCollide = false
			end)
		end
	end
end

-- Frena antes del golpe para que el choque ocurra a baja velocidad: el daño de
-- casi cualquier juego escala con la velocidad del impacto.
function FH.softenCarImpact(vehicle, forcePart, deltaTime)
	local velocity = forcePart.AssemblyLinearVelocity
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = horizontal.Magnitude
	local impactCap = FH.getCarArmorImpactCap()

	local lastVelocity = FH.CarArmorRuntime.LastVelocity
	FH.CarArmorRuntime.LastVelocity = velocity
	if lastVelocity then
		local change = (velocity - lastVelocity).Magnitude
		local crashed = change
			> math.max(FH.CAR_ARMOR_BOUNCE_LIMIT, speed * 0.75)
		if crashed and speed > impactCap then
			pcall(function()
				forcePart.AssemblyLinearVelocity = Vector3.new(
					horizontal.Unit.X * impactCap,
					math.min(velocity.Y, 0),
					horizontal.Unit.Z * impactCap
				)
				forcePart.AssemblyAngularVelocity =
					forcePart.AssemblyAngularVelocity * 0.35
			end)
			return
		end
	end

	if speed <= impactCap then return end

	local direction = horizontal.Unit
	local extent = FH.getCarExtents(vehicle)

	local scanDistance = extent + speed * FH.CAR_ARMOR_LOOKAHEAD
	local result = Workspace:Raycast(
		forcePart.Position,
		direction * scanDistance,
		FH.getCarArmorRaycastParams(vehicle)
	)
	if not result then return end

	local gap = math.max(result.Distance - extent, 0)
	local allowed = math.max(impactCap, gap / FH.CAR_ARMOR_LOOKAHEAD)
	if speed <= allowed then return end

	pcall(function()
		forcePart.AssemblyLinearVelocity = Vector3.new(
			direction.X * allowed,
			velocity.Y,
			direction.Z * allowed
		)
	end)
end

function FH.stopCarArmor()
	if FH.CarArmorRuntime.Connection then
		FH.CarArmorRuntime.Connection:Disconnect()
		FH.CarArmorRuntime.Connection = nil
	end
	FH.restoreCarSeatCollision()
	FH.CarArmorRuntime.Vehicle = nil
	FH.CarArmorRuntime.LastVelocity = nil
	FH.CarArmorRuntime.HealthSources = {}
	FH.CarArmorRuntime.HealthScanAt = 0
end

function FH.setCarArmor(enabled)
	FH.CarArmorEnabled = enabled == true
	FH.stopCarArmor()
	if not FH.CarArmorEnabled then return end

	FH.CarArmorRuntime.Connection = RunService.Heartbeat:Connect(function(deltaTime)
		if not FH.CarArmorEnabled then return end
		pcall(function()
			local vehicle, seat = FH.getCurrentVehicle()
			if not vehicle or not vehicle.Parent then
				FH.CarArmorRuntime.Vehicle = nil
				FH.CarArmorRuntime.LastVelocity = nil
				FH.CarArmorRuntime.HealthSources = {}
				return
			end

			local forcePart = (seat and seat.AssemblyRootPart)
				or vehicle.PrimaryPart
				or seat
			if forcePart and forcePart:IsA("BasePart") then
				if FH.CarArmorRuntime.Vehicle ~= vehicle then
					FH.CarArmorRuntime.LastVelocity = nil
				end
				FH.applyCarSeatCollision(vehicle)
				if FH.isSnapCarDriving() then
					-- Los PivotTo del Snap Car parecen choques; no se frenan.
					FH.CarArmorRuntime.LastVelocity = nil
				else
					FH.softenCarImpact(vehicle, forcePart, deltaTime)
				end
			end

			FH.softenCarHealthLoss(vehicle, os.clock())
			FH.CarArmorRuntime.Vehicle = vehicle
		end)
	end)
end

