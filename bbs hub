	FH.InfStamina = { Enabled = false, Loop = nil }
	FH.setInfStamina = function(on)
		FH.InfStamina.Enabled = on == true
		if FH.InfStamina.Loop then
			pcall(function() task.cancel(FH.InfStamina.Loop) end)
			FH.InfStamina.Loop = nil
		end
		if not FH.InfStamina.Enabled then return end
		FH.InfStamina.Loop = task.spawn(function()
			while FH.InfStamina.Enabled do
				pcall(function()
					-- Setea stamina al máximo via attributes y NumberValues del player/char.
					for _, root in ipairs({LocalPlayer, LocalPlayer.Character}) do
						if root then
							for name, val in pairs(root:GetAttributes()) do
								if tostring(name):lower():find("stamina") and type(val) == "number" then
									root:SetAttribute(name, val <= 1.5 and 1 or math.max(val, 100))
								end
							end
							for _, obj in ipairs(root:GetDescendants()) do
								if (obj:IsA("NumberValue") or obj:IsA("IntValue"))
									and obj.Name:lower():find("stamina") then
									pcall(function()
										obj.Value = obj.Value <= 1.5 and 1 or math.max(obj.Value, 100)
									end)
								end
							end
						end
					end
					-- Hook al módulo Sprint del juego si existe.
					pcall(function()
						local sm = require(ReplicatedStorage.Modules.Game.Sprint)
						if type(sm) == "table" then
							for k, v in pairs(sm) do
								local n = tostring(k):lower()
								if n:find("stamina") and type(v) == "number" then
									sm[k] = math.max(v, 100)
								end
							end
						end
					end)
					-- Mantener sprint activo
					pcall(function()
						local RS = game:GetService("ReplicatedStorage")
						for _, r in ipairs(RS:GetDescendants()) do
							if r:IsA("RemoteEvent") and r.Name:lower():find("sprint") then
								pcall(function() r:FireServer(true) end)
							end
						end
					end)
				end)
				task.wait(0.3)
			end
		end)
	end

