--========================================================--
-- DROPPED ITEM DISTANCE TRACKER - PANEL TÁCTIL
--
-- SOLO cambia el número del panel.
-- NO ejecuta TP automáticamente.
-- Se queda con el mismo objeto hasta que desaparece.
--========================================================--

TP.SettingsVisual.TouchItemDistanceTarget = nil
TP.SettingsVisual.TouchItemDistanceSavedValue = nil
TP.SettingsVisual.TouchItemDistanceMaxAcquire = 50

-- Si el usuario escribe manualmente una distancia en el panel táctil,
-- el escáner automático queda congelado en ese valor hasta el próximo respawn.
TP.SettingsVisual.TouchItemDistanceManualLocked = false
TP.SettingsVisual.TouchItemDistanceManualValue = nil

TP.SettingsVisual.GetDroppedItemsFolder = function()
	return workspace:FindFirstChild("DroppedItems")
		or workspace:FindFirstChild("DroppedItem")
		or TP.DroppedItems
end

TP.SettingsVisual.GetDroppedItemAnchor = function(item)
	if not item or not item.Parent then
		return nil
	end

	if item:IsA("BasePart") then
		return item
	end

	if not item:IsA("Model") then
		return nil
	end

	local pickup =
		item:FindFirstChild("PickUpZone", true)

	if pickup and not pickup:IsA("BasePart") then
		pickup = nil
	end

	return pickup
		or item.PrimaryPart
		or item:FindFirstChildWhichIsA("BasePart", true)
end

TP.SettingsVisual.IsDroppedItemUnderground = function(item, part)
	if not item or not part or not part.Parent then
		return false
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	local exclude = {
		item
	}

	if Player.Character then
		table.insert(exclude, Player.Character)
	end

	params.FilterDescendantsInstances = exclude

	-- Buscamos una superficie REAL arriba del item.
	-- Si hay piso/terreno anclado varios studs arriba, lo consideramos underground.
	local result =
		workspace:Raycast(
			part.Position + Vector3.new(0, 0.5, 0),
			Vector3.new(0, 60, 0),
			params
		)

	if not result then
		return false
	end

	local hit = result.Instance
	local realSurface =
		hit == workspace.Terrain
		or (
			hit
			and hit:IsA("BasePart")
			and hit.Anchored
		)

	if not realSurface then
		return false
	end

	local verticalGap =
		result.Position.Y - part.Position.Y

	-- Evita detectar objetos normales apoyados justo sobre el piso.
	return verticalGap >= 2
end

TP.SettingsVisual.FindNearestDroppedItem = function(origin, maxDistance, horizontalOnly)
	if typeof(origin) ~= "Vector3" then
		return nil, nil, math.huge
	end

	local folder =
		TP.SettingsVisual.GetDroppedItemsFolder()

	if not folder then
		return nil, nil, math.huge
	end

	local bestItem = nil
	local bestPart = nil
	local bestDistance = math.huge

	for _, item in ipairs(folder:GetChildren()) do
		local part =
			TP.SettingsVisual.GetDroppedItemAnchor(item)

		if part then
			local delta =
				part.Position - origin

			local distance

			if horizontalOnly then
				distance =
					Vector3.new(
						delta.X,
						0,
						delta.Z
					).Magnitude
			else
				distance = delta.Magnitude
			end

			if distance < bestDistance
				and (
					not maxDistance
					or distance <= maxDistance
				) then

				bestItem = item
				bestPart = part
				bestDistance = distance
			end
		end
	end

	return bestItem, bestPart, bestDistance
end

TP.SettingsVisual.RestoreTouchItemManualValue = function()
	if TP.SettingsVisual.TouchItemDistanceSavedValue ~= nil then
		TP.TouchPanelValue =
			tonumber(
				TP.SettingsVisual.TouchItemDistanceSavedValue
			)
			or TP.TouchPanelValue

		TP.SettingsVisual.TouchItemDistanceSavedValue = nil

		if TP.fsInput and TP.fsInput.Parent then
			TP.fsInput.Text =
				tostring(
					math.floor(
						TP.TouchPanelValue + 0.5
					)
				)
				.. "m"
		end
	end

	TP.SettingsVisual.TouchItemDistanceTarget = nil
end

task.spawn(function()
	while TP.TouchPanelGui and TP.TouchPanelGui.Parent do
		task.wait(0.08)

		-- Panel apagado: vuelve al valor manual anterior.
		if not TP.TouchPanelGui.Enabled then
			TP.SettingsVisual.RestoreTouchItemManualValue()
			continue
		end

		local snapTrackerActive =
			TP.SettingsVisual.TouchSnapCarState
			and TP.SettingsVisual.TouchSnapCarState.Enabled

		-- Fuera de Snap conservamos el bloqueo manual viejo. Dentro de Snap,
		-- la profundidad queda guardada en S.Depth y el cuadro puede seguir
		-- mostrando la distancia al item sin cambiar esa profundidad.
		if TP.SettingsVisual.TouchItemDistanceManualLocked and not snapTrackerActive then
			local manualValue = tonumber(TP.SettingsVisual.TouchItemDistanceManualValue)
			if manualValue then
				TP.TouchPanelValue = math.clamp(manualValue, 5, 100)
				if TP.fsInput and TP.fsInput.Parent and UserInputService:GetFocusedTextBox() ~= TP.fsInput then
					TP.fsInput.Text = tostring(TP.TouchPanelValue) .. "m"
				end
			end
			continue
		end

		-- En modo TP hacia arriba no interferimos con su valor 50.
		if TP.SettingsVisual.TouchPanelUpMode then
			continue
		end

		-- Mientras YA estás abajo, congelamos el valor con el que bajaste.
		-- Así nunca te mueve automáticamente al acercarte/alejarte.
		if TP.isSnappedDown then
			continue
		end

		-- Bajo Snap Car el campo muestra SIEMPRE la profundidad configurada.
		-- No sobrescribir la profundidad manual (hasta 2000) con distancias a DroppedItems.
		if TP.SettingsVisual.TouchSnapCarState
			and TP.SettingsVisual.TouchSnapCarState.Enabled then
			if UserInputService:GetFocusedTextBox() ~= TP.fsInput then
				local S = TP.SettingsVisual.TouchSnapCarState
				TP.fsInput.Text = tostring(math.clamp(math.floor((tonumber(S.Depth) or TP.TouchPanelValue or 20) + 0.5), 5, 2000)) .. "m"
			end
			continue
		end

		-- No sobrescribe el número mientras lo estás editando con el teclado.
		if UserInputService:GetFocusedTextBox() == TP.fsInput then
			continue
		end

		local char = Player.Character
		local root =
			char and char:FindFirstChild("HumanoidRootPart")

		if not root then
			continue
		end

		local folder =
			TP.SettingsVisual.GetDroppedItemsFolder()

		local target =
			TP.SettingsVisual.TouchItemDistanceTarget

		local targetValid =
			target
			and folder
			and target.Parent == folder

		local targetPart =
			targetValid
			and TP.SettingsVisual.GetDroppedItemAnchor(target)
			or nil

		if targetPart
			and not TP.SettingsVisual.IsDroppedItemUnderground(
				target,
				targetPart
			) then

			targetPart = nil
			TP.SettingsVisual.TouchItemDistanceTarget = nil
		end

		-- SOLO busca otro cuando el anterior ya desapareció.
		if not targetPart then
			local newTarget, newPart =
				TP.SettingsVisual.FindNearestDroppedItem(
					root.Position,
					tonumber(
						TP.SettingsVisual.TouchItemDistanceMaxAcquire
					) or 40,
					false
				)

			if newTarget
				and newPart
				and TP.SettingsVisual.IsDroppedItemUnderground(
					newTarget,
					newPart
				) then
				if TP.SettingsVisual.TouchItemDistanceSavedValue == nil then
					TP.SettingsVisual.TouchItemDistanceSavedValue =
						TP.TouchPanelValue
				end

				TP.SettingsVisual.TouchItemDistanceTarget =
					newTarget

				target = newTarget
				targetPart = newPart
			else
				TP.SettingsVisual.RestoreTouchItemManualValue()
				continue
			end
		end

		-- Cambia únicamente el valor visible/que usará el próximo TP.
		local distance =
			(targetPart.Position - root.Position).Magnitude

		local displayDistance =
			math.clamp(
				math.floor(distance + 0.5),
				1,
				100
			)

		TP.TouchPanelValue = displayDistance

		if TP.fsInput and TP.fsInput.Parent then
			TP.fsInput.Text =
				tostring(displayDistance) .. "m"
		end

		-- IMPORTANTE:
		-- NO tocamos targetDepth aquí.
		-- targetDepth se captura únicamente cuando tú presionas TP.
	end
end)

