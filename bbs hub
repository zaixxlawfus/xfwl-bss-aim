	return FH.ConfigManager.Folder .. "/" .. FH.cleanConfigName(name) .. ".json"
end

-- Algunos ejecutores no crean subcarpetas: si la ruta con carpeta falla, se
-- guarda y se lee de un archivo plano en la raiz.
function FH.getConfigFallbackPath(name)
	return FH.ConfigManager.Folder .. "_" .. FH.cleanConfigName(name) .. ".json"
end

function FH.writeConfigFile(name, encoded)
	local folderOk = FH.ensureConfigFolder()
	if folderOk then
		local ok = pcall(function()
			writefile(FH.getConfigPath(name), encoded)
		end)
		if ok and isfile(FH.getConfigPath(name)) then return true end
	end
	local ok = pcall(function()
		writefile(FH.getConfigFallbackPath(name), encoded)
	end)
	return ok and isfile(FH.getConfigFallbackPath(name)) == true
end

function FH.readConfigFile(name)
	for _, path in ipairs({
		FH.getConfigPath(name),
		FH.getConfigFallbackPath(name),
	}) do
		local exists = false
		pcall(function() exists = isfile(path) end)
		if exists then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(readfile(path))
			end)
			if ok and type(data) == "table" then return data end
		end
	end
	return nil
end

function FH.readConfigIndex()
	if not FH.ensureConfigFolder() or not isfile(FH.ConfigManager.IndexFile) then
		return {"Default"}, "Default"
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(FH.ConfigManager.IndexFile))
	end)
	if not ok or type(data) ~= "table" then return {"Default"}, "Default" end
	local names = type(data.Names) == "table" and data.Names or {"Default"}
	if #names == 0 then names = {"Default"} end
	return names, data.LastConfig or names[1]
end

function FH.writeConfigIndex(names, lastConfig)
	if not FH.ensureConfigFolder() then return false end
	return pcall(function()
		writefile(FH.ConfigManager.IndexFile, HttpService:JSONEncode({
			Names = names,
			LastConfig = lastConfig
		}))
	end)
end

