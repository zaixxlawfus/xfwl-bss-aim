function FH.updateDroppedItemsESP()
	if not FH.DroppedItemsESPEnabled then
		FH.clearDroppedItemsESP()
		return
	end

	local droppedFolder = Workspace:FindFirstChild("DroppedItems")
	if not droppedFolder then
		FH.clearDroppedItemsESP()
		return
	end

	local activeItems = {}
	local itemCounts = {}
	for _, candidate in ipairs(droppedFolder:GetChildren()) do
		if candidate:IsA("Model") then
			local candidateName = candidate:GetAttribute("DisplayName")
				or candidate:GetAttribute("ItemName")
				or candidate.Name
			local candidateId = candidate:GetAttribute("ItemId")
				or candidate:GetAttribute("Id")
			local candidateKey = candidateId
				and ("id:" .. tostring(candidateId))
				or ("name:" .. string.lower(tostring(candidateName)))
			itemCounts[candidateKey] = (itemCounts[candidateKey] or 0) + 1
		end
	end
	local character = LocalPlayer.Character
	local localRoot = character and character:FindFirstChild("HumanoidRootPart")

	for _, item in ipairs(droppedFolder:GetChildren()) do
		if item:IsA("Model") then
			activeItems[item] = true
			local part = item:FindFirstChildWhichIsA("BasePart")
			local displayName = item:GetAttribute("DisplayName")
				or item:GetAttribute("ItemName")
				or item.Name
			local itemId = item:GetAttribute("ItemId")
				or item:GetAttribute("Id")
			local itemKey = itemId
				and ("id:" .. tostring(itemId))
				or ("name:" .. string.lower(tostring(displayName)))
			
			if part then
				local espData = FH.DroppedItemsESPObjects[item]
				local rarityName, rarityColor = FH.getItemRarityInfo(item)

				if not espData or not espData.Board or not espData.Board.Parent then
					local board = Instance.new("BillboardGui")
					board.Name = "DroppedItemESP"
					board.Adornee = part
					board.Size = UDim2.fromOffset(150, 32)
					board.StudsOffsetWorldSpace = Vector3.new(0, 1.5, 0)
					board.AlwaysOnTop = true
					board.LightInfluence = 0
					board.MaxDistance = 150
					board.Enabled = true
					board.Parent = PlayerGui

					local nameLabel = Instance.new("TextLabel")
					nameLabel.Name = "ItemNameLabel"
					nameLabel.Size = UDim2.new(1, 0, 0, 18)
					nameLabel.BackgroundTransparency = 1
					nameLabel.Font = Enum.Font.Gotham
					nameLabel.TextSize = 11
					nameLabel.TextColor3 = rarityColor
					nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
					nameLabel.TextStrokeTransparency = 0.6
					nameLabel.TextXAlignment = Enum.TextXAlignment.Center
					nameLabel.TextYAlignment = Enum.TextYAlignment.Center
					nameLabel.Parent = board

					local infoLabel = Instance.new("TextLabel")
					infoLabel.Name = "ItemInfoLabel"
					infoLabel.Position = UDim2.new(0, 0, 0, 18)
					infoLabel.Size = UDim2.new(1, 0, 0, 12)
					infoLabel.BackgroundTransparency = 1
					infoLabel.Font = Enum.Font.Gotham
					infoLabel.TextSize = 9
					infoLabel.TextColor3 = rarityColor
					infoLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
					infoLabel.TextStrokeTransparency = 0.6
					infoLabel.TextXAlignment = Enum.TextXAlignment.Center
					infoLabel.TextYAlignment = Enum.TextYAlignment.Center
					infoLabel.Parent = board

					FH.DroppedItemsESPObjects[item] = {
						Board = board,
						Label = nameLabel,
						InfoLabel = infoLabel,
						Part = part
					}
				else
					if espData.Board.Adornee ~= part then
						espData.Board.Adornee = part
					end
					if espData.Label and espData.Label.TextColor3 ~= rarityColor then
						espData.Label.TextColor3 = rarityColor
					end
				end

				espData = FH.DroppedItemsESPObjects[item]
				if espData.Label then
					espData.Label.Text = "[" .. tostring(displayName) .. "]"
					espData.Label.TextColor3 = rarityColor
				end
				if espData.InfoLabel then
					local details = {}
					local itemCount = itemCounts[itemKey] or 1
					if itemCount > 1 then
						details[#details + 1] = "x" .. tostring(itemCount)
					end
					if localRoot and localRoot.Parent then
						local distance = (localRoot.Position - part.Position).Magnitude
						details[#details + 1] = tostring(math.floor(distance + 0.5)) .. " m"
					end
					espData.InfoLabel.Text = table.concat(details, "  •  ")
					espData.InfoLabel.TextColor3 = rarityColor
				end
			end
		end
	end

	for item, espData in pairs(FH.DroppedItemsESPObjects) do
		if not activeItems[item] or not item.Parent then
			FH.removeDroppedItemESP(item)
		end
	end
end

