function FH.isCharacterReady()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return character
		and character.Parent
		and humanoid
		and humanoid.Parent
		and humanoid.Health > 0
		and character:FindFirstChild("HumanoidRootPart") ~= nil
		and LocalPlayer:FindFirstChildOfClass("Backpack") ~= nil
end

function FH.loadCrateController()
	if FH.CrateController then return FH.CrateController end
	if FH.CrateModuleUnavailable then return nil end
	if not FH.isCharacterReady() then return nil end
	local ok, result = pcall(function()
		local modulesFolder = ReplicatedStorage:FindFirstChild("Modules")
		local gameModules = modulesFolder and modulesFolder:FindFirstChild("Game")
		local crateSystem = gameModules and gameModules:FindFirstChild("CrateSystem")
		local crateModule = crateSystem and crateSystem:FindFirstChild("Crate")
		return crateModule and require(crateModule) or nil
	end)
	if ok and type(result) == "table" then
		FH.CrateController = result
	elseif not ok or result == nil then
		FH.CrateModuleUnavailable = true
	end
	return FH.CrateController
end

