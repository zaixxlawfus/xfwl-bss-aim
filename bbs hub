	local nextClear = 0
	while task.wait(0.05) do
		if FH.PickupEnabled then
			pcall(FH.CheckAndPickup)
		end
		local now = os.clock()
		if now >= nextClear then
			nextClear = now + 1
			FH.CollectedItems = {}
		end
	end
end)

function FH.normalizeAssetId(value, fallback)
	if value == nil then return fallback end
	local text = tostring(value)
	if text == "" or text == "0" then return fallback end
	if text:match("^rbxassetid://") then return text end
	if text:match("^%d+$") then return "rbxassetid://" .. text end
	return text
end

function FH.findItemDefinition(item)
	local itemsFolder = ReplicatedStorage:FindFirstChild("Items")
	if itemsFolder == nil then return nil end

	local attributes = item:GetAttributes()
	local itemType = attributes.item_type
		or attributes.ItemType
		or attributes.ItemTypeName
	local displayName = attributes.DisplayName
		or attributes.ItemName
		or item.Name

	local function findInCategory(category)
		if category == nil then return nil end
		local direct = category:FindFirstChild(item.Name)
			or category:FindFirstChild(tostring(displayName))
		if direct then return direct end

		for _, definition in ipairs(category:GetChildren()) do
			if definition:GetAttribute("DisplayName") == displayName
				or (attributes.ItemId ~= nil
					and definition:GetAttribute("ItemId") == attributes.ItemId)
				or (attributes.Id ~= nil
					and definition:GetAttribute("Id") == attributes.Id)
			then
				return definition
			end
		end
		return nil
	end

	if itemType then
		local category = itemsFolder:FindFirstChild(tostring(itemType))
			or itemsFolder:FindFirstChild(string.lower(tostring(itemType)))
		local definition = findInCategory(category)
		if definition then return definition end
	end

	for _, category in ipairs(itemsFolder:GetChildren()) do
		local definition = findInCategory(category)
		if definition then return definition end
	end
	return nil
end

function FH.getItemRarityInfo(item)
	local definition = FH.findItemDefinition(item)
	local rarity = item:GetAttribute("RarityName")
		or item:GetAttribute("Rarity")
		or (definition and (
			definition:GetAttribute("RarityName")
			or definition:GetAttribute("Rarity")
		))
		or "Common"
	local rarityName = FH.normalizeRarityName(rarity)
	local rarityColor = FH.at[rarityName] or FH.at.Common
	return rarityName, rarityColor
end

