function FH.getHttpRequester()
	if type(request) == "function" then return request end
	if type(http_request) == "function" then return http_request end
	if syn and type(syn.request) == "function" then return syn.request end
	return nil
end

function FH.getPublicServerPage(url)
	local ok, body = pcall(function()
		return HttpService:GetAsync(url)
	end)
	if ok and type(body) == "string" then return body end

	local gameHttpOk, gameBody = pcall(function()
		return game:HttpGet(url)
	end)
	if gameHttpOk and type(gameBody) == "string" then return gameBody end

	local requester = FH.getHttpRequester()
	if not requester then return nil end
	local requestOk, response = pcall(function()
		return requester({
			Url = url,
			Method = "GET",
		})
	end)
	if not requestOk or type(response) ~= "table" then return nil end
	return response.Body or response.body
end

