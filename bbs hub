FH.modifyBBSFists = function(tool, enabled)
	if not tool or not tool:IsA("Tool") then return end

	local attributes = tool:GetAttributes()
	local attributeNames = {}
	for attributeName in pairs(attributes) do
		attributeNames[#attributeNames + 1] = attributeName
	end
	table.sort(attributeNames)
	if #attributeNames < 7 then return end

	local firstAttribute = attributeNames[6]
	local secondAttribute = attributeNames[7]
	local originals = FH.BBSMeleeOriginalAttributes[tool]

	if enabled then
		originals = originals or {}
		FH.BBSMeleeOriginalAttributes[tool] = originals
		if originals[firstAttribute] == nil then
			originals[firstAttribute] = tool:GetAttribute(firstAttribute)
		end
		if originals[secondAttribute] == nil then
			originals[secondAttribute] = tool:GetAttribute(secondAttribute)
		end
		pcall(function()
			tool:SetAttribute(firstAttribute, 360)
			tool:SetAttribute(secondAttribute, 20)
		end)
	elseif originals then
		pcall(function()
			if originals[firstAttribute] ~= nil then
				tool:SetAttribute(firstAttribute, originals[firstAttribute])
			end
			if originals[secondAttribute] ~= nil then
				tool:SetAttribute(secondAttribute, originals[secondAttribute])
			end
		end)
	end
end

