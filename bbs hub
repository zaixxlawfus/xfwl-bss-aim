function FH.getSliderNumber(value, fallback)
	if type(value) == "number" then
		return (value == value and value ~= math.huge and value ~= -math.huge) and value or fallback
	end
	if type(value) == "string" then
		return tonumber(value) or fallback
	end
	if type(value) == "table" then
		for _, v in ipairs(value) do
			local num = tonumber(v)
			if num then return num end
		end
		local raw = value.Value or value.value or value.Number or value.number
		if raw then return FH.getSliderNumber(raw, fallback) end
	end
	if typeof(value) == "Instance" then
		local ok, instVal = pcall(function() return value.Value end)
		if ok and instVal then return FH.getSliderNumber(instVal, fallback) end
	end
	return fallback
end

function FH.getControlText(value)
	if typeof(value) == "table" then
		value = value.Title
			or value.Value
			or value.value
			or value.Name
			or value[1]
	end
	return tostring(value or "")
end

