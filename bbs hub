	return false, "ERROR AL UNIRSE AL JOBID: " .. tostring(err)
end

function FH.serverHop()
	if FH.ServerHopBusy then return false, "EL SALTO DE SERVIDOR YA ESTÁ EN CURSO" end
	FH.ServerHopBusy = true
	local selectedServer
	local cursor = ""

	for _ = 1, 8 do
		local url = string.format(
			"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
			game.PlaceId,
			cursor ~= "" and "&cursor=" .. HttpService:UrlEncode(cursor) or ""
		)
		local body = FH.getPublicServerPage(url)
		local ok, data = body and pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if not ok or type(data) ~= "table" then break end
		for _, server in ipairs(data.data or {}) do
			local playing = tonumber(server.playing) or 0
			local maxPlayers = tonumber(server.maxPlayers) or 0
			if server.id and server.id ~= game.JobId
				and (maxPlayers == 0 or playing < maxPlayers) then
				selectedServer = server
				break
			end
		end
		if selectedServer then break end
		cursor = tostring(data.nextPageCursor or "")
		if cursor == "" then break end
	end

	if selectedServer then
		local ok, err = pcall(function()
			TeleportService:TeleportToPlaceInstance(
				game.PlaceId,
				selectedServer.id,
				LocalPlayer
			)
		end)
		FH.ServerHopBusy = false
		if ok then return true, "BUSCANDO OTRO SERVIDOR PÚBLICO..." end
		return false, "ERROR AL CAMBIAR DE SERVIDOR: " .. tostring(err)
	end

	local ok, err = pcall(function()
		TeleportService:Teleport(game.PlaceId, LocalPlayer)
	end)
	FH.ServerHopBusy = false
	if ok then return true, "BUSCANDO OTRO SERVIDOR PÚBLICO..." end
	return false, "ERROR AL CAMBIAR DE SERVIDOR: " .. tostring(err)
end

FH.SpectateState = {
	Player = nil,
	PreviousCameraType = nil,
	PreviousCameraSubject = nil,
}

function FH.getCurrentCamera()
	return workspace.CurrentCamera or Camera
end

function FH.stopSpectating()
	local currentCamera = FH.getCurrentCamera()
	if currentCamera then
		local previousSubject = FH.SpectateState.PreviousCameraSubject
		if previousSubject and previousSubject.Parent then
			currentCamera.CameraSubject = previousSubject
		else
			local localCharacter = LocalPlayer.Character
			local localHumanoid = localCharacter
				and localCharacter:FindFirstChildOfClass("Humanoid")
			if localHumanoid then
				currentCamera.CameraSubject = localHumanoid
			end
		end
		if FH.SpectateState.PreviousCameraType then
			currentCamera.CameraType = FH.SpectateState.PreviousCameraType
		end
	end
	FH.SpectateState.Player = nil
	FH.SpectateState.PreviousCameraType = nil
	FH.SpectateState.PreviousCameraSubject = nil
end

function FH.startSpectating(player)
	if not player or player == LocalPlayer or player.Parent ~= Players then
		FH.stopSpectating()
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local currentCamera = FH.getCurrentCamera()
	if not humanoid or not currentCamera then return false end

	if FH.SpectateState.Player == nil then
		FH.SpectateState.PreviousCameraType = currentCamera.CameraType
		FH.SpectateState.PreviousCameraSubject = currentCamera.CameraSubject
	end
	FH.SpectateState.Player = player
	currentCamera.CameraType = Enum.CameraType.Custom
	currentCamera.CameraSubject = humanoid
	return true
end

function FH.getSpectatorValues()
	local values = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			values[#values + 1] = player.Name
		end
	end
	table.sort(values, function(a, b)
		return string.lower(a) < string.lower(b)
	end)
	return values
end

function FH.isSilentAimIgnored(player)
	if not player or player == LocalPlayer then
		return true
	end
	local playerName = string.lower(player.Name)
	for ignoredName in pairs(FH.SilentAimIgnoredNames) do
		if ignoredName ~= "" and string.find(playerName, ignoredName, 1, true) then
			return true
		end
	end
	return false
end

function FH.getSilentAimPing()
	local ping = 0.1
	pcall(function()
		ping = LocalPlayer:GetNetworkPing() or ping
	end)
	return math.clamp(ping, 0.03, 0.35)
end

function FH.isSilentAimPlayerUsable(player, applySafeZoneFilter)
	if not player
		or player.Parent ~= Players
		or FH.isSilentAimIgnored(player)
		or not player.Character
	then
		return false
	end

	local character = player.Character
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	local sameTeam = player.Team
		and LocalPlayer.Team
		and player.Team == LocalPlayer.Team
	if not character:FindFirstChild("Head")
		or not root
		or not humanoid
		or humanoid.Health <= 0
		or sameTeam
	then
		return false
	end

	local safe = false
	pcall(function()
		safe = FH.isInSafeZone(root) == true
	end)
	if safe
		and applySafeZoneFilter ~= false
		and FH.SilentAimIgnoreSafeZone
	then
		return false
	end

	return true
end

function FH.isValidSilentAimTarget(player, aimCamera, center, maxDistance)
	if not FH.isSilentAimPlayerUsable(player) then
		return false
	end

	local character = player.Character
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")

	local screenPosition, onScreen = aimCamera:WorldToViewportPoint(head.Position)
	if not onScreen or screenPosition.Z <= 0 then
		return false
	end

	local distance = (
		Vector2.new(screenPosition.X, screenPosition.Y) - center
	).Magnitude
	return distance <= (maxDistance or FH.SilentAimFOV), screenPosition, distance
end

function FH.getSilentAimTarget()
	local aimCamera = workspace.CurrentCamera or Camera
	if not aimCamera then
		return nil
	end

	local center = Vector2.new(
		aimCamera.ViewportSize.X / 2,
		aimCamera.ViewportSize.Y / 2
	)
	local closest
	local closestWorldDistance = math.huge
	local closestScreenDistance = math.huge
	local localRoot = LocalPlayer.Character
		and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

	if not localRoot then
		FH.SilentAimCurrentTarget = nil
		return nil
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local valid, _, screenDistance =
			FH.isValidSilentAimTarget(player, aimCamera, center)
		if valid then
			local root = player.Character
				and player.Character:FindFirstChild("HumanoidRootPart")
			local worldDistance = root
				and (root.Position - localRoot.Position).Magnitude

			if worldDistance
				and (
					screenDistance < closestScreenDistance
					or (
						screenDistance == closestScreenDistance
						and worldDistance < closestWorldDistance
					)
				)
			then
				closestWorldDistance = worldDistance
				closestScreenDistance = screenDistance
				closest = player
			end
		end
	end

	FH.SilentAimCurrentTarget = closest
	return closest
end

function FH.getSilentAimVelocity(player, root)
	local history = FH.SilentAimVelocityHistory[player]
	if not history or #history < 2 then
		return root.AssemblyLinearVelocity or Vector3.zero
	end

	local velocity = Vector3.zero
	local samples = 0
	for index = 2, #history do
		local previous = history[index - 1]
		local current = history[index]
		local elapsed = current.time - previous.time
		if elapsed > 0 then
			velocity = velocity + (current.position - previous.position) / elapsed
			samples = samples + 1
		end
	end

	return samples > 0 and velocity / samples
		or root.AssemblyLinearVelocity
		or Vector3.zero
end

function FH.predictSilentAimPosition(player, head, root)
	if not head or not root then return nil end
	local velocity = FH.getSilentAimVelocity(player, root)
	return head.Position + velocity * FH.getSilentAimPing() * 1.2
end

function FH.isSilentAimShotgun()
	local character = LocalPlayer.Character
	if not character then return false end

	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			local ammoType = child:GetAttribute("AmmoType")
			if typeof(ammoType) == "string"
				and (string.find(string.lower(ammoType), "shotgun", 1, true)
					or string.find(string.lower(ammoType), "shootgun", 1, true))
			then
				return true
			end
		end
	end
	return false
end

function FH.getSilentAimTargetPartName(character)
	if FH.SilentMixEnabled then
		return FH.SilentAimNextPartIsHead and "Head" or "Torso"
	end
	return "Head"
end

function FH.getSilentAimShotPart(character, partName)
	if not character then return nil end
	if type(partName) == "boolean" then
		partName = partName and "Head" or "Torso"
	end
	if partName ~= "Head" and partName ~= "Torso" then
		partName = "Head"
	end
	if partName == "Head" then
		return character:FindFirstChild("Head")
	end
	return character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart")
end

function FH.createJuixShotTracer(origin, destination, targetHumanoid)
	if not origin or not destination then return nil end
	local distance = (destination - origin).Magnitude
	if distance <= 0.01 then return nil end

	local tracer
	local ok = pcall(function()
		tracer = Instance.new("Part")
		tracer.Name = "BBSHubJuixShotTracer"
		tracer.Anchored = true
		tracer.CanCollide = false
		tracer.CanTouch = false
		tracer.CanQuery = false
		tracer.CastShadow = false
		tracer.Size = Vector3.new(0.08, 0.08, distance)
		tracer.CFrame =
			CFrame.new(origin, destination) * CFrame.new(0, 0, -distance / 2)
		tracer.Material = Enum.Material.Neon
		tracer.Transparency = 0.35
		tracer.Color = Color3.fromRGB(255, 0, 0)
		tracer.Parent = workspace
		Debris:AddItem(tracer, 4)
	end)

	if not ok or not tracer then return nil end

	if targetHumanoid then
		local healthBefore = targetHumanoid.Health
		task.delay(0.1, function()
			if tracer and tracer.Parent then
				tracer.Color = targetHumanoid.Health < healthBefore
					and Color3.fromRGB(0, 255, 0)
					or Color3.fromRGB(255, 0, 0)
			end
		end)
	end

	return tracer
end

FH.SilentAimHookInstalled = false

function FH.handleJuixFireServer(sendRemote, originalFireServer, self, ...)
	local args = {...}
	local unpackArgs = table.unpack or unpack

	if self == sendRemote
		and FH.SilentAimEnabled
		and args[2] == "shoot_gun"
	then
		local target = FH.getSilentAimTarget()
		local character = target and target.Character
		local targetHead = character and character:FindFirstChild("Head")
		local targetRoot = character
			and character:FindFirstChild("HumanoidRootPart")
		local targetHumanoid = character
			and character:FindFirstChildOfClass("Humanoid")
		local localCharacter = LocalPlayer.Character
		local localHead = localCharacter
			and localCharacter:FindFirstChild("Head")
		local localRoot = localCharacter
			and localCharacter:FindFirstChild("HumanoidRootPart")
		local origin = localHead
			and localHead.Position
			or localRoot
			and localRoot.Position

		if targetHead
			and targetRoot
			and targetHumanoid
			and targetHumanoid.Health > 0
			and origin
		then
			local targetPartName = FH.getSilentAimTargetPartName(character)
			local targetPart =
				FH.getSilentAimShotPart(character, targetPartName)
				or targetHead
			local predictedPosition = FH.predictSilentAimPosition(
				target,
				targetPart,
				targetRoot
			)

			if predictedPosition then
				FH.SilentAimCurrentTarget = target

				if FH.SilentMixEnabled then
					FH.SilentAimNextPartIsHead = not FH.SilentAimNextPartIsHead
				end

				args[4] = CFrame.new(origin, predictedPosition)
				FH.createJuixShotTracer(
					origin,
					predictedPosition,
					targetHumanoid
				)

				if FH.isSilentAimShotgun() then
					local pellets = {}
					for _ = 1, 6 do
						local spread = Vector3.new(
							math.random(-2, 2) * 0.03,
							math.random(-2, 2) * 0.03,
							math.random(-2, 2) * 0.03
						)
						pellets[#pellets + 1] = {
							[1] = {
								Instance = targetPart,
								Normal = Vector3.new(0, 1, 0),
								Position = predictedPosition + spread,
							},
						}
					end
					args[5] = pellets
				else
					args[5] = {
						[1] = {
							[1] = {
								Instance = targetPart,
								Normal = Vector3.new(0, 1, 0),
								Position = predictedPosition,
							},
						},
					}
				end
			end
		end
	end

	return originalFireServer(self, unpackArgs(args))
end

function FH.installJuixSilentAimHook()
	if FH.SilentAimHookInstalled then return true end
	if type(hookfunction) ~= "function" then
		return false
	end

	FH.Remotes = FH.Remotes or ReplicatedStorage:FindFirstChild("Remotes")
	local sendRemote = FH.Remotes and FH.Remotes:FindFirstChild("Send")
	if not sendRemote or type(sendRemote.FireServer) ~= "function" then
		return false
	end

	local originalFireServer
	local ok = pcall(function()
		originalFireServer = hookfunction(sendRemote.FireServer, function(self, ...)
			return FH.handleJuixFireServer(
				sendRemote,
				originalFireServer,
				self,
				...
			)
		end)
	end)

	if ok and type(originalFireServer) == "function" then
		FH.SilentAimHookInstalled = true
		return true
	end
	return false
end

task.spawn(function()
	for _ = 1, 20 do
		if FH.installJuixSilentAimHook() then return end
		task.wait(0.25)
	end
end)

function FH.getFriendValues()
	local values = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			values[#values + 1] = player.Name
		end
	end
	table.sort(values, function(a, b)
		return string.lower(a) < string.lower(b)
	end)
	return values
end

function FH.applyFriendListSelection(selectedValues)
	FH.SilentAimIgnoredNames = {}
	if type(selectedValues) ~= "table" then
		selectedValues = selectedValues and { selectedValues } or {}
	end

	for _, selectedValue in ipairs(selectedValues) do
		local playerName = FH.getControlText(selectedValue)
		FH.SilentAimIgnoredNames[string.lower(playerName)] = true
	end
end

RunService.Heartbeat:Connect(function(deltaTime)
	local now = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and humanoid.Health > 0 then
				local history = FH.SilentAimVelocityHistory[player]
				if not history then
					history = {}
					FH.SilentAimVelocityHistory[player] = history
				end
				history[#history + 1] = {
					time = now,
					position = root.Position,
				}
				if #history > 6 then
					table.remove(history, 1)
				end
			else
				FH.SilentAimVelocityHistory[player] = nil
			end
		end
	end
end)

