	TP.SettingsVisual.TouchSnapCarGetVehicle = function()
		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local seat = hum and hum.SeatPart

		if not seat or not seat:IsA("VehicleSeat") then
			return nil, nil, nil
		end

		local vehicle = seat:FindFirstAncestorOfClass("Model")
		if not vehicle then
			return nil, nil, nil
		end

		local root =
			vehicle.PrimaryPart
			or seat.AssemblyRootPart
			or seat
			or vehicle:FindFirstChildWhichIsA("BasePart", true)

		if root then
			root = root.AssemblyRootPart or root
		end

		return vehicle, root, seat
	end

	TP.SettingsVisual.TouchSnapCarFlatLook = function(cf)
		local look = Vector3.new(
			cf.LookVector.X,
			0,
			cf.LookVector.Z
		)

		if look.Magnitude <= 0.001 then
			return Vector3.new(0, 0, -1)
		end

		return look.Unit
	end

	TP.SettingsVisual.TouchSnapCarUpright = function(position, lookVector)
		local flat = Vector3.new(
			lookVector.X,
			0,
			lookVector.Z
		)

		if flat.Magnitude <= 0.001 then
			flat = Vector3.new(0, 0, -1)
		else
			flat = flat.Unit
		end

		return CFrame.lookAt(
			position,
			position + flat,
			Vector3.yAxis
		)
	end

	TP.SettingsVisual.TouchSnapCarMoveTowards = function(current, target, maxDelta)
		if current < target then
			return math.min(current + maxDelta, target)
		elseif current > target then
			return math.max(current - maxDelta, target)
		end

		return target
	end

	TP.SettingsVisual.TouchSnapCarSavePart = function(part, allowTouch)
		local S = TP.SettingsVisual.TouchSnapCarState
		if not part or not part:IsA("BasePart") then return end

		if S.OriginalProps[part] == nil then
			S.OriginalProps[part] = {
				CanCollide = part.CanCollide,
				CanTouch = part.CanTouch,
				CanQuery = part.CanQuery,
			}
		end

		pcall(function()
			part.CanCollide = false
			part.CanTouch = allowTouch == true
			part.CanQuery = false
		end)
	end

	TP.SettingsVisual.TouchSnapCarPhase = function(vehicle)
