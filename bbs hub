FH.FindNetGetCounter = function()
	local getGarbageCollector = type(getgc) == "function" and getgc
	if not getGarbageCollector then
		return nil
	end

	local ok, garbage = pcall(getGarbageCollector, true)
	if not ok or type(garbage) ~= "table" then
		return nil
	end

	for _, v in ipairs(garbage) do
		if typeof(v) == "table"
			and rawget(v, "event")
			and rawget(v, "func")
		then
			return v
		end
	end
	return nil
end
FH.NetGetFunction = nil

function FH.NetGet(...)
	FH.Remotes = FH.Remotes or ReplicatedStorage:FindFirstChild("Remotes")
	local now = os.clock()
	if not FH.NetGetFunction
		and FH.FindNetGetCounter
		and now >= FH.NetGetSearchAt
	then
		FH.NetGetFunction = FH.FindNetGetCounter()
		FH.NetGetSearchAt = now + FH.NETGET_RESCAN_INTERVAL
	end
	if not FH.NetGetFunction or not FH.Remotes then return end
	local args = {...}
	for i, v in ipairs(args) do
		if typeof(v) == "Instance" and v:IsA("Model") and #v:GetChildren() == 0 then
			local dropped = Workspace:FindFirstChild("DroppedItems")
			if dropped then
				local item = dropped:FindFirstChildWhichIsA("Model")
				if item then args[i] = item else return end
			else return end
		end
	end
	FH.NetGetFunction.func = (FH.NetGetFunction.func or 0) + 1
	local _, result = pcall(function()
		return FH.Remotes:WaitForChild("Get"):InvokeServer(FH.NetGetFunction.func, unpack(args))
	end)
	return result
end

