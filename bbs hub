	local function safeWindUICall(label, callback, fallback)
		local ok, result = xpcall(callback, function(errorMessage)
			return tostring(errorMessage)
		end)
		if not ok then
			return fallback
		end
		return result
	end

	local function protectControlOptions(options, controlLabel)
		if type(options) ~= "table" or type(options.Callback) ~= "function" then
			return options
		end

		local protected = {}
		for key, value in pairs(options) do
			protected[key] = value
		end
		if type(protected.Desc) == "string" then
			local compactDesc = protected.Desc:gsub("%.$", "")
			if #compactDesc > 36 then
				local shortened = compactDesc:sub(1, 36)
				local boundary = shortened:match("^(.*)%s+[^%s]*$")
				if boundary and #boundary >= 20 then
					shortened = boundary
				end
				compactDesc = shortened .. "..."
			end
			protected.Desc = compactDesc
		end
		local callback = protected.Callback
		protected.Callback = function(...)
			local callbackArgs = {...}
			local ok, result = xpcall(function()
				return callback(table.unpack(callbackArgs))
			end, function(errorMessage)
				return tostring(errorMessage)
			end)
			FH.requestConfigAutoSave()
			if not ok then
				return nil
			end
			return result
		end

		return protected
	end

	-- Indice de controles para el buscador: por cada control creado se guarda
