TP.SettingsVisual.TouchCarBindPoseCharacter = function(char)
    TP.SettingsVisual.TouchCarPoseGeneration += 1
    local generation = TP.SettingsVisual.TouchCarPoseGeneration
    if TP.SettingsVisual.TouchCarPoseSeatConnection then
        TP.SettingsVisual.TouchCarPoseSeatConnection:Disconnect()
        TP.SettingsVisual.TouchCarPoseSeatConnection = nil
    end
    TP.SettingsVisual.TouchCarRestoreSeatPose()
    if not char then return end
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 12)
        if not hum or generation ~= TP.SettingsVisual.TouchCarPoseGeneration then return end
        TP.SettingsVisual.TouchCarPoseSeatConnection = hum.Seated:Connect(function()
            task.defer(function()
                if generation == TP.SettingsVisual.TouchCarPoseGeneration then
                    TP.SettingsVisual.TouchCarApplySeatPose()
                end
            end)
        end)
        -- En algunos vehículos SeatPart se actualiza un poco después de Seated.
        for _ = 1, 12 do
            if generation ~= TP.SettingsVisual.TouchCarPoseGeneration then return end
            TP.SettingsVisual.TouchCarApplySeatPose()
            task.wait(0.15)
        end
    end)
end

