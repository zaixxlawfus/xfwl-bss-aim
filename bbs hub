-- BUMP AURA (Dump Car)
-- Los modulos del juego se cargan la primera vez que se enciende el toggle.
-- ==========================================
FH.BumpAuraEnabled = false

FH.BumpAuraRuntime = {
	Ready = false,
	Supported = (
		game.PlaceId == 104715542330896
		or game.PlaceId == 97556409405464
	),
	Generation = 0,
	Running = false,
	Net = nil,
	VehicleModule = nil,
	CharModule = nil,
}

function FH.initBumpAura()
	if FH.BumpAuraRuntime.Ready then return true end

	pcall(function()
		if getgenv then
			getgenv().identifyexecutor = nil
		end
		if getfenv then
			local env = getfenv()
			env.identifyexecutor = nil
		end
	end)

	if not FH.BumpAuraRuntime.Supported then
		FH.BumpAuraRuntime.Ready = false
		return false
	end

	local ok = pcall(function()
		local modules = ReplicatedStorage:WaitForChild("Modules", 10)
		local core = modules and modules:WaitForChild("Core", 10)
		if not core then error("Core no disponible") end

		FH.BumpAuraRuntime.Net = require(core:WaitForChild("Net", 10))
		FH.BumpAuraRuntime.VehicleModule = require(
			modules
				:WaitForChild("Game", 10)
				:WaitForChild("VehicleSystem", 10)
				:WaitForChild("Vehicle", 10)
		)
		FH.BumpAuraRuntime.CharModule = require(core:WaitForChild("Char", 10))
	end)

	FH.BumpAuraRuntime.Ready = ok == true
	return FH.BumpAuraRuntime.Ready
end

function FH.getBumpAuraDistance(targetRoot)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not targetRoot then return math.huge end
	return (root.Position - targetRoot.Position).Magnitude
end

function FH.startBumpAuraLoop()
	if not FH.BumpAuraRuntime.Ready
		or not FH.BumpAuraEnabled
		or FH.BumpAuraRuntime.Running
	then
		return
	end

	FH.BumpAuraRuntime.Generation += 1
	local generation = FH.BumpAuraRuntime.Generation
	FH.BumpAuraRuntime.Running = true

	task.spawn(function()
		while FH.BumpAuraEnabled
			and FH.BumpAuraRuntime.Ready
			and FH.BumpAuraRuntime.Generation == generation
		do
			task.wait(0.07)

			pcall(function()
				local car = FH.BumpAuraRuntime.VehicleModule.get_car_player_is_in()
				if not car then return end

				local driverSeat = car:FindFirstChild("DriverSeat", true)
				if not driverSeat or not driverSeat:IsA("BasePart") then return end

				for _, target in FH.BumpAuraRuntime.CharModule.get_all() do
					if target and target ~= LocalPlayer.Character then
						local hrp = target:FindFirstChild("HumanoidRootPart")
						if hrp and FH.getBumpAuraDistance(hrp) < 100 then
							local assembly = driverSeat.AssemblyLinearVelocity
								+ Vector3.new(115, 115, 115)
							FH.BumpAuraRuntime.Net.send(
								"run_over",
								car,
								target,
								assembly
							)
						end
					end
				end
			end)
		end

		if FH.BumpAuraRuntime.Generation == generation then
			FH.BumpAuraRuntime.Running = false
		end
	end)
end

function FH.setBumpAura(enabled)
	FH.BumpAuraEnabled = enabled == true

	-- Lo espera asi el modulo original.
	_G.BumpAura = FH.BumpAuraEnabled

	if not FH.BumpAuraEnabled then
		FH.BumpAuraRuntime.Generation += 1
		FH.BumpAuraRuntime.Running = false
		return true
	end

	if not FH.initBumpAura() then
		return false
	end

	FH.startBumpAuraLoop()
	return true
end

