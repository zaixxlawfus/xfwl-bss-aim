	FH.applyGunModsToContainer(LocalPlayer:FindFirstChildOfClass("Backpack"))
end

FH.SkipAnimationRuntime = {
	Token = 0,
}

function FH.setSkipAnimation(enabled)
	FH.EnabledSkip = enabled == true
	FH.SkipAnimationRuntime.Token = FH.SkipAnimationRuntime.Token + 1
	local token = FH.SkipAnimationRuntime.Token

	if not FH.EnabledSkip then
		pcall(function()
			if FH.CrateController
				and FH.CrateController.skipping
				and FH.CrateController.skipping.set
			then
				FH.CrateController.skipping.set(false)
			end
		end)
		return
	end

	task.spawn(function()
		while FH.EnabledSkip and token == FH.SkipAnimationRuntime.Token do
			task.wait(0.05)
			if FH.isCharacterReady() then
				if not FH.CrateController then
					FH.loadCrateController()
				end
				if FH.CrateController
					and FH.CrateController.class
					and FH.CrateController.class.objects
				then
					for _, crate in pairs(FH.CrateController.class.objects) do
						pcall(function()
							if crate.states
								and crate.states.open
								and crate.states.open.set
							then
								crate.states.open.set(true)
							end
							if FH.CrateController.skipping
								and FH.CrateController.skipping.set
							then
								FH.CrateController.skipping.set(true)
							end
						end)
					end
				end
				if FH.CrateController
					and FH.CrateController.spinning
					and FH.CrateController.spinning.get
					and FH.CrateController.skip_spin
				then
					local spinningOk, isSpinning = pcall(function()
						return FH.CrateController.spinning.get()
					end)
					if spinningOk and not isSpinning then
						pcall(function()
							FH.CrateController.skip_spin()
						end)
					end
				end
			end
		end
	end)
end

