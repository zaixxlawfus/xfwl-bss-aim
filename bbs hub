		lens.Position = UDim2.fromOffset(0, 0)
		lens.BackgroundTransparency = 1
		lens.BorderSizePixel = 0
		lens.ZIndex = 61
		lens.Parent = glassHolder
		Instance.new("UICorner", lens).CornerRadius = UDim.new(1, 0)
		local lensStroke = Instance.new("UIStroke", lens)
		lensStroke.Color = Color3.fromRGB(205, 220, 240)
		lensStroke.Thickness = 1.6
		lensStroke.Transparency = 0.1

		local handle = Instance.new("Frame")
