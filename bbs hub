	FH.SearchIndex = {}

	local function registerSearchEntry(methodName, options, control, tabLabel)
		if type(options) ~= "table" then return end
		local title = options.Title
		if type(title) ~= "string" or title == "" then return end
		if methodName == "Section" or methodName == "Paragraph" then return end

		FH.SearchIndex[#FH.SearchIndex + 1] = {
			Title = title,
			Desc = type(options.Desc) == "string" and options.Desc or "",
			Tab = tabLabel,
			Control = control,
		}
	end

	local function makeSafeTab(tab, label)
		local proxy = {}
		return setmetatable(proxy, {
			__index = function(_, methodName)
				local method = tab and tab[methodName]
				if type(method) ~= "function" then
					return function() end
				end
				return function(_, ...)
					local args = {...}
					local originalOptions = args[1]
					local control = safeWindUICall(label .. "." .. tostring(methodName), function()
						if type(args[1]) == "table" then
							args[1] = protectControlOptions(
								args[1],
								label .. "." .. tostring(args[1].Title or methodName)
							)
						end
						return method(tab, table.unpack(args))
					end)
					pcall(
						registerSearchEntry,
						methodName,
						originalOptions,
						control,
						label
					)
					return control
				end
			end,
		})
	end

	local function createSafeTab(label, options)
		local tab = safeWindUICall("pestana " .. label, function()
			return Window:Tab(options)
		end)
		return makeSafeTab(tab, label)
	end

