		local centerRay = aimCamera:ViewportPointToRay(center.X, center.Y)
		local origin = centerRay.Origin
		local destination = targetPart.Position
		local distance = (destination - origin).Magnitude
		if distance <= 0.01 then
			juixAimLine.Transparency = 1
			juixAimLineOverlay.Transparency = 1
			juixAimLineScreen.Visible = false
			return
		end

		local originScreen, originOnScreen =
			aimCamera:WorldToViewportPoint(origin)
		if not originOnScreen then
			juixAimLineScreen.Visible = false
			return
		end

		local startPoint = Vector2.new(originScreen.X, originScreen.Y)
		local endPoint = Vector2.new(screenPosition.X, screenPosition.Y)
		local screenDelta = endPoint - startPoint
		local screenDistance = screenDelta.Magnitude
		if screenDistance <= 1 then
			juixAimLineScreen.Visible = false
			return
		end

		juixAimLineScreen.Position = UDim2.fromOffset(
			(startPoint.X + endPoint.X) / 2,
			(startPoint.Y + endPoint.Y) / 2
		)
		juixAimLineScreen.Size = UDim2.fromOffset(
			screenDistance,
			AIM_LINE_PIXEL_THICKNESS
		)
		juixAimLineScreen.Rotation =
			math.deg(math.atan2(screenDelta.Y, screenDelta.X))
		juixAimLineScreen.Visible = true

		juixAimLine.Transparency = 1
		juixAimLineOverlay.Transparency = 1
	end)

	local PlayerMarkers = FH.PlayerESPRuntime.Objects
	local playerMarkerElapsed = FH.PLAYER_MARKER_UPDATE_INTERVAL
	local playerHighlightElapsed = FH.PLAYER_HIGHLIGHT_UPDATE_INTERVAL
	local PlayerMarkerRetryTokens = {}

	local function markerAnchor(character)
		if not character then return nil end
		local root = character:FindFirstChild("HumanoidRootPart", true)
		if root and root:IsA("BasePart") then return root end

		local primaryPart = character.PrimaryPart
		if primaryPart and primaryPart:IsA("BasePart") then
			return primaryPart
		end

		for _, partName in ipairs({"UpperTorso", "Torso", "LowerTorso", "Head"}) do
			local part = character:FindFirstChild(partName, true)
			if part and part:IsA("BasePart") then
				return part
			end
		end

		return character:FindFirstChildWhichIsA("BasePart", true)
	end

	local function findCharacterHumanoid(character)
		if not character then return nil end
		return character:FindFirstChildOfClass("Humanoid")
			or character:FindFirstChildWhichIsA("Humanoid", true)
	end

	local function createPlayerESPProxy(character)
		local proxy = Instance.new("Part")
		proxy.Name = "PlayerESPProxy"
		proxy.Anchored = true
		proxy.CanCollide = false
		proxy.CanTouch = false
		proxy.CanQuery = false
		proxy.CastShadow = false
		proxy.Transparency = 1
		proxy.Size = Vector3.new(0.2, 0.2, 0.2)

		local ok, pivot = pcall(function()
			return character:GetPivot()
		end)
		if ok and typeof(pivot) == "CFrame" then
			proxy.CFrame = pivot
		end
		proxy.Parent = workspace
		return proxy
	end

	local function getPlayerMarkerAnchor(marker, character)
		if not character then return nil end

		local realAnchor = markerAnchor(character)
		if realAnchor then
			if marker.Proxy then
				pcall(function() marker.Proxy:Destroy() end)
				marker.Proxy = nil
			end
			return realAnchor
		end

		if not marker.Proxy or not marker.Proxy.Parent then
			marker.Proxy = createPlayerESPProxy(character)
		end

		pcall(function()
			local pivot = character:GetPivot()
			if typeof(pivot) == "CFrame" then
				marker.Proxy.CFrame = pivot
			end
		end)
		return marker.Proxy
	end

	local PlayerHighlights = FH.PlayerESPRuntime.Highlights
	local PlayerNameESPGuis = {}
	local PlayerHitEffectClock = {}
	local PlayerHitEffectUntil = {}
	local ensurePlayerMarker
	local HIGHLIGHT_NORMAL_COLOR = Color3.fromRGB(255, 255, 255)
	local HIGHLIGHT_SAFE_COLOR = Color3.fromRGB(0, 255, 0)
	local HIGHLIGHT_HIT_COLOR = Color3.fromRGB(255, 0, 0)
	local HIGHLIGHT_FILL_TRANSPARENCY = 0.55
	local HIGHLIGHT_OUTLINE_TRANSPARENCY = 0.1
	local applyPlayerESPToAll

	local function getPlayerHighlightColor(player, character)
		local root = markerAnchor(character)
		if root and FH.isInSafeZone and FH.isInSafeZone(root) then
			return HIGHLIGHT_SAFE_COLOR
		end
		return HIGHLIGHT_NORMAL_COLOR
	end

	local function isPlayerESPInRange(character)
		if not character then return false end
		return true
	end

	local function clearPlayerHighlight(player)
		local highlight = PlayerHighlights[player]
		if highlight then
			pcall(function() highlight:Destroy() end)
