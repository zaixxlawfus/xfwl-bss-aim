function FH.compileRemoteSource(source, sourceName)
	if type(source) ~= "string" or source == "" then
		return nil, sourceName .. " devolvio una fuente vacia"
	end
	local compiler = type(loadstring) == "function" and loadstring
		or (type(load) == "function" and load or nil)
	if not compiler then
		return nil, "loadstring/load no esta disponible"
	end
	local ok, chunk = pcall(compiler, source)
	if not ok or type(chunk) ~= "function" then
		return nil, "could not compile " .. sourceName .. ": " .. tostring(chunk)
	end
	return chunk
end

