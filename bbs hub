                TP.SettingsVisual.TouchVerticalChaseStroke.Color = (phase ~= "ready")
                    and Color3.fromRGB(140, 255, 205) or Color3.fromRGB(170, 120, 255)
                TP.SettingsVisual.TouchVerticalChaseArrowHolder.Rotation =
                    (phase == "stop_down") and 180 or 0
                b.Text = (phase == "down" or phase == "up") and "STOP" or ""
                b.TextSize = 9
                b.Font = Enum.Font.GothamBold
                b.TextColor3 = Color3.fromRGB(246, 237, 255)
                TP.SettingsVisual.TouchVerticalChaseArrowHolder.Visible =
                    (phase ~= "down" and phase ~= "up")
            end
            if TP.SettingsVisual.TouchKeyLabel then
                TP.SettingsVisual.TouchKeyLabel.Visible = false
            end
        else
			if left then
				left.Size = UDim2.fromOffset(18, 18)
				left.Position = UDim2.new(0, 8, 1, -27)
				left.TextSize = 13
				left.Text = TP.SettingsVisual.TouchTargetFollowEnabled and "×" or ""
				left.BackgroundColor3 =
					TP.SettingsVisual.TouchTargetFollowEnabled
					and TP.COLORS.Blue
					or Color3.fromRGB(28, 31, 42)
			end

			if right then
				right.Size = UDim2.fromOffset(18, 18)
				right.Position = UDim2.new(1, -26, 1, -27)
				right.TextSize = 13
                right.Text = ""
                right.BackgroundColor3 =
                    os.clock() < (TP.SettingsVisual.TouchCarTPFeedbackUntil or 0)
                    and TP.COLORS.Blue
                    or Color3.fromRGB(28, 31, 42)
			end

			if TP.SettingsVisual.TouchLeftKeyLabel then
				TP.SettingsVisual.TouchLeftKeyLabel.Visible = false
			end
            if TP.SettingsVisual.TouchRightKeyLabel then
                TP.SettingsVisual.TouchRightKeyLabel.Visible = false
            end
            if TP.SettingsVisual.TouchCarTPLabel then
                TP.SettingsVisual.TouchCarTPLabel.Visible = true
            end
            if TP.SettingsVisual.TouchCarJumpButton then
                TP.SettingsVisual.TouchCarJumpButton.Visible = false
            end
            if TP.SettingsVisual.TouchVerticalChaseButton then
                TP.SettingsVisual.TouchVerticalChaseButton.Visible = false
            end
