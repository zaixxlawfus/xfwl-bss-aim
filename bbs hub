function FH.isGunTool(tool)
	if not tool or not tool:IsA("Tool") then return false end
	local gunItems = FH.getGunItemsFolder()
	return (gunItems and gunItems:FindFirstChild(tool.Name) ~= nil)
		or tool.Name:match("Gun") ~= nil
		or tool:FindFirstChild("Handle") ~= nil
end

function FH.applyGunModsToTool(tool)
	if not FH.isGunTool(tool) then return end
	pcall(function()
		tool:SetAttribute("fire_rate", FH.FireRateValue)
		tool:SetAttribute("accuracy", FH.AccuracyValue)
	end)
end

function FH.applyGunModsToContainer(container)
	if not container then return end
	for _, object in ipairs(container:GetChildren()) do
		if object:IsA("Tool") then
			FH.applyGunModsToTool(object)
		end
	end
end

function FH.applyGunModsNow()
