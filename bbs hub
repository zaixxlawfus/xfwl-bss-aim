-- Averigua la rareza de un item tirado. Se prueba el atributo del modelo, la
-- herramienta que trae dentro y por ultimo la malla, que es la llave con la
-- que el hub ya tiene registradas todas las armas.
function FH.getDroppedItemRarity(item)
	local rarity
	pcall(function()
		rarity = item:GetAttribute("RarityName")
	end)
	if type(rarity) == "string" and rarity ~= "" then return rarity end

	local info
	pcall(function()
		local tool = item:FindFirstChildWhichIsA("Tool", true)
		if tool then
			info = FH.getWeaponInfo(tool)
		end
	end)
	if info and info.Rarity then return info.Rarity end

	pcall(function()
		local entry = FH.WeaponDB[item.Name]
		if entry then info = entry end
	end)
	if info and info.Rarity then return info.Rarity end

	pcall(function()
		local handle = item:FindFirstChild("Handle", true)
		if not handle then return end
		local key
		local mesh = handle:FindFirstChildOfClass("SpecialMesh")
		if mesh then
			key = mesh.MeshId .. (mesh.TextureId or "")
		elseif handle:IsA("MeshPart") then
			key = handle.MeshId .. (handle.TextureID or "")
		end
		if key and FH.WeaponDB[key] then
			info = FH.WeaponDB[key]
		end
	end)
	if info and info.Rarity then return info.Rarity end

	return nil
end

function FH.isPickupRarityAllowed(item)
	local rarity = FH.getDroppedItemRarity(item)
	-- Sin rareza reconocida se recoge: el bloqueo solo aplica a lo que se
	-- puede identificar con certeza.
	if not rarity then return true end
	return FH.PickupBlockedRarities[rarity] ~= true
end

-- Lista de las rarezas bloqueadas, en el orden en que se muestran, para que
-- el selector arranque marcando lo que ya estaba guardado.
function FH.getPickupRarityValue()
	local selected = {}
	for _, name in ipairs(FH.PICKUP_RARITIES) do
		if FH.PickupBlockedRarities[name] then
			selected[#selected + 1] = name
		end
	end
	return selected
end

function FH.applyPickupRaritySelection(selectedValues)
	local blocked = {}
	if type(selectedValues) == "table" then
		for key, value in pairs(selectedValues) do
