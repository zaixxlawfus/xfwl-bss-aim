    }
    local b64 = table.concat(b64Parts, "")

    local function b64decode(data)
        local b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local out = {}
        for i = 1, #data, 4 do
            local c1, c2, c3, c4 = string.byte(data, i, i+3)
            if not c1 then break end
            local n1 = string.find(b, string.char(c1), 1, true) - 1
            local n2 = c2 and ((string.find(b, string.char(c2), 1, true) or 1) - 1) or 0
            local n3 = c3 and c3 ~= 61 and ((string.find(b, string.char(c3), 1, true) or 1) - 1) or 0
            local n4 = c4 and c4 ~= 61 and ((string.find(b, string.char(c4), 1, true) or 1) - 1) or 0
            local b1 = n1 * 4 + math.floor(n2 / 16)
            local b2 = (n2 % 16) * 16 + math.floor(n3 / 4)
            local b3 = (n3 % 4) * 64 + n4
            out[#out+1] = string.char(b1)
            if c3 and c3 ~= 61 then out[#out+1] = string.char(b2) end
            if c4 and c4 ~= 61 then out[#out+1] = string.char(b3) end
        end
        return table.concat(out)
    end

    local okDec, bin = pcall(b64decode, b64)
    if not okDec or not bin or #bin < 100 then
        BBS_NEON_URL = "rbxassetid://11584087020"
        return
    end

    local filename = "bbs_neon.jpg"
    local okWrite = pcall(writefile, filename, bin)
    if not okWrite then
        BBS_NEON_URL = "rbxassetid://11584087020"
        return
    end

    local assetUrl
    pcall(function()
        if type(getcustomasset) == "function" then
            assetUrl = getcustomasset(filename)
        elseif type(getsynasset) == "function" then
            assetUrl = getsynasset(filename)
        end
    end)
    if type(assetUrl) == "string" and #assetUrl > 0 then
        BBS_NEON_URL = assetUrl
    else
        BBS_NEON_URL = "rbxassetid://11584087020"
    end
end)

-- Loop que aplica BBS_NEON_URL al openButton + skybox cada 1s.
task.spawn(function()
    local Players = game:GetService("Players")
    local Lighting = game:GetService("Lighting")
    local LP = Players.LocalPlayer
    local CoreGui = game:GetService("CoreGui")

    -- Crea el sky custom una vez; el loop sólo re-aplica Image.
    local function ensureSky()
        local sky = Lighting:FindFirstChild("BBSNeonSky")
        if not sky then
            -- quita otros skies del juego
            for _, s in ipairs(Lighting:GetChildren()) do
                if s:IsA("Sky") then s.Parent = nil end
            end
            sky = Instance.new("Sky")
            sky.Name = "BBSNeonSky"
            sky.CelestialBodiesShown = false
            sky.StarCount = 0
            sky.SunAngularSize = 0
            sky.MoonAngularSize = 0
            sky.Parent = Lighting
        end
        return sky
    end

    -- Pinta SOLO el OpenButtonMain del WindUI — nada más. Evita
    -- repintar frames o imagenes random del hud/panel.
    local function paintOnlyWindUIOpenButton()
        if not (FH and FH.MainWindow and FH.MainWindow.OpenButtonMain) then return end
        local wrap = FH.MainWindow.OpenButtonMain
        if typeof(wrap) ~= "Instance" then return end
        for _, d in ipairs(wrap:GetDescendants()) do
            if d:IsA("ImageButton") or d:IsA("ImageLabel") then
                pcall(function()
                    d.Image = BBS_NEON_URL
                    d.ImageColor3 = Color3.fromRGB(255, 255, 255)
                    d.ImageTransparency = 0
                    d.ScaleType = Enum.ScaleType.Crop
                end)
            end
        end
    end

    while true do
        task.wait(1.0)
        if BBS_NEON_URL then
            pcall(function()
                local sky = ensureSky()
                for _, face in ipairs({"SkyboxBk","SkyboxDn","SkyboxFt","SkyboxLf","SkyboxRt","SkyboxUp"}) do
                    if sky[face] ~= BBS_NEON_URL then sky[face] = BBS_NEON_URL end
                end
            end)
            -- Re-llamar EditOpenButton del WindUI con la imagen azul correcta.
            pcall(function()
                if FH and FH.MainWindow
                    and type(FH.MainWindow.EditOpenButton) == "function" then
                    FH.MainWindow:EditOpenButton({
                        Title = "",
                        Icon = BBS_NEON_URL,
                        CornerRadius = UDim.new(0, 14),
                        StrokeThickness = 3,
                        StrokeColor = Color3.fromRGB(0, 200, 255),
                        Scale = 1.15,
                        Enabled = true,
                        OnlyIcon = true,
                        Draggable = true,
                    })
                end
            end)
            pcall(paintOnlyWindUIOpenButton)
        end
    end
end)

-- ============================================================
-- PANEL TINT dinámico (FH.BBSTheme) — rápido y persistente.
-- ============================================================
task.spawn(function()
    local LP = game:GetService("Players").LocalPlayer
    local CoreGui = game:GetService("CoreGui")
    local TINT_TRANS = 0.55

    local function tint(root)
        FH.BBSTheme = FH.BBSTheme or {
            BG = Color3.fromRGB(0, 60, 140),
            Stroke = Color3.fromRGB(0, 220, 255),
        }
        local TINT_BG      = FH.BBSTheme.BG
        local STROKE_COLOR = FH.BBSTheme.Stroke
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("Frame") and d.BackgroundTransparency < 1 then
                local sx = d.AbsoluteSize.X
                local sy = d.AbsoluteSize.Y
                if sx >= 40 and sy >= 20 then
                    pcall(function()
                        d.BackgroundColor3 = TINT_BG
                        d.BackgroundTransparency = TINT_TRANS
                        local existing = d:FindFirstChild("BBSStroke")
                        if existing and existing:IsA("UIStroke") then
                            existing.Color = STROKE_COLOR
                        end
                        if not existing then
                            local s = Instance.new("UIStroke", d)
                            s.Name = "BBSStroke"
                            s.Color = STROKE_COLOR
                            s.Thickness = 1
                            s.Transparency = 0.55
                            s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                        end
                    end)
                end
            end
        end
    end

    while true do
        task.wait(0.3)
        pcall(function()
            local roots = {}
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then table.insert(roots, pg) end
            table.insert(roots, CoreGui)
            if type(gethui) == "function" then
                local ok, h = pcall(gethui)
                if ok and typeof(h) == "Instance" then table.insert(roots, h) end
            end
            for _, r in ipairs(roots) do
                for _, sg in ipairs(r:GetChildren()) do
                    if sg:IsA("ScreenGui") then
                        local n = sg.Name:lower()
                        if n:find("bbs") or n:find("hub") or n:find("wind") then
                            tint(sg)
                        end
                    end
                end
            end
        end)
    end
end)

-- ============================================================
-- SOFT AIM engine (motor del source Rayiz_KING, adaptado).
-- Lee FH.SoftAim configurado desde el AimTab del panel.
-- Modos: Head / Torso / RightArm / LeftArm / AutoHeadTorso / AutoArms
-- Prediction: part.Position + velocity * 0.03
-- Lerp smoothness: 1 - FH.SoftAim.Smoothing (menor valor = más agresivo)
-- Wallcheck: raycast blacklist con char.Parent + LP.Character.
-- ============================================================
do
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local RS = game:GetService("RunService")
    local LP = Players.LocalPlayer
    FH.SoftAim = FH.SoftAim or {
        Enabled = false, Smoothing = 0.22, FOV = 120,
        Wallcheck = false, Part = "Head",
        HeldPC = false, HeldTouch = false,
    }
    FH.SoftAim.Prediction = FH.SoftAim.Prediction or 0.03
    FH.SoftAim.AutoSwitchInterval = FH.SoftAim.AutoSwitchInterval or 0.7

    local AIM_MODES = {
        Head        = {single = "Head"},
        Torso       = {single = "HumanoidRootPart"},
        RightArm    = {single = "RightUpperArm", fallback = "Right Arm"},
        LeftArm     = {single = "LeftUpperArm",  fallback = "Left Arm"},
        AutoHeadTorso = {auto = {"Head", "HumanoidRootPart"}},
        AutoArms      = {auto = {"RightUpperArm", "LeftUpperArm"}},
        -- aliases
        Neck        = {single = "Head"},
        Chest       = {single = "HumanoidRootPart"},
    }
    local autoIndex, autoTimer = 1, 0

    UIS.InputBegan:Connect(function(i, p)
        if p then return end
        if i.UserInputType == Enum.UserInputType.MouseButton2 then FH.SoftAim.HeldPC = true
        elseif i.UserInputType == Enum.UserInputType.Touch then FH.SoftAim.HeldTouch = true end
    end)
    UIS.InputEnded:Connect(function(i, p)
        if i.UserInputType == Enum.UserInputType.MouseButton2 then FH.SoftAim.HeldPC = false
        elseif i.UserInputType == Enum.UserInputType.Touch then FH.SoftAim.HeldTouch = false end
    end)

    local function currentPartName()
        local mode = AIM_MODES[FH.SoftAim.Part] or AIM_MODES.Head
        if mode.auto then return mode.auto[autoIndex] end
        return mode.single
    end

    local function getPart(char)
        local name = currentPartName()
        local part = char:FindFirstChild(name)
        if not part then
            local mode = AIM_MODES[FH.SoftAim.Part]
            if mode and mode.fallback then part = char:FindFirstChild(mode.fallback) end
        end
        if not part then
            part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        end
        return part
    end

    local function predictPos(char, part)
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return part.Position end
        return part.Position + root.AssemblyLinearVelocity * (FH.SoftAim.Prediction or 0.03)
    end

    local function isVisible(char, part)
        local cam = workspace.CurrentCamera
        if not cam then return false end
        local origin = cam.CFrame.Position
        local p = RaycastParams.new()
        p.FilterType = Enum.RaycastFilterType.Exclude
        p.IgnoreWater = true
        local filter = {LP.Character, part.Parent}
        for _, n in ipairs({"Vehicles","Cars","Motorcycles","Trucks","Boats"}) do
            local f = workspace:FindFirstChild(n); if f then table.insert(filter, f) end
        end
        p.FilterDescendantsInstances = filter
        local r = workspace:Raycast(origin, part.Position - origin, p)
        return not r
    end

    local function pickTarget()
        local cam = workspace.CurrentCamera
        if not cam then return nil end
        local center = cam.ViewportSize / 2
        local best, bestDist = nil, FH.SoftAim.FOV
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP and pl.Character then
                local hum = pl.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = getPart(pl.Character)
                    if part then
                        local predicted = predictPos(pl.Character, part)
                        local sp, on = cam:WorldToViewportPoint(predicted)
                        if on and sp.Z > 0 then
                            local d = ((sp.X - center.X) ^ 2 + (sp.Y - center.Y) ^ 2) ^ 0.5
                            if d < bestDist then
                                if not FH.SoftAim.Wallcheck or isVisible(pl.Character, part) then
                                    best, bestDist = {char = pl.Character, part = part, pred = predicted}, d
                                end
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    RS.Heartbeat:Connect(function(dt)
        if not FH.SoftAim.Enabled then return end
        local mode = AIM_MODES[FH.SoftAim.Part]
        if not (mode and mode.auto) then return end
        autoTimer = autoTimer + dt
        if autoTimer >= (FH.SoftAim.AutoSwitchInterval or 0.7) then
            autoTimer = 0
            autoIndex = autoIndex % #mode.auto + 1
        end
    end)

    RS.RenderStepped:Connect(function()
        if not FH.SoftAim.Enabled then return end
        if not (FH.SoftAim.HeldPC or FH.SoftAim.HeldTouch) then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local tgt = pickTarget()
        if not tgt then return end
        local goal = CFrame.new(cam.CFrame.Position, tgt.pred)
        cam.CFrame = cam.CFrame:Lerp(goal, 1 - FH.SoftAim.Smoothing)
    end)
end
