TP.SettingsVisual.RunUpdateEsp = function()
	if TP.SettingsVisual.UpdateEspBusy then return false end
	local setNameESP = FH.setPlayerNameESP
	if not setNameESP then return false end

	TP.SettingsVisual.UpdateEspBusy = true

	task.spawn(function()
		local previous = FH.ESPConfig and FH.ESPConfig.NameESP == true
		pcall(setNameESP, not previous)
		RunService.Heartbeat:Wait()
		pcall(setNameESP, previous)
		TP.SettingsVisual.UpdateEspBusy = false
	end)
	return true
end

